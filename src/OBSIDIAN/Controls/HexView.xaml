<UserControl x:Class="Obsidian.Controls.HexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True">

    <Grid Background="{DynamicResource CodeBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="26" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource PanelAlt}"
                BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="250">
                    <TextBox x:Name="FindBox" Style="{StaticResource SearchBox}" Padding="26,4,8,4" FontSize="10.5"
                             KeyDown="FindBox_KeyDown" ToolTip="Search bytes: text or hex (48 8B ?? 05)" />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="10"
                               Foreground="{DynamicResource Dim}" Margin="9,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                    <TextBlock Text="Find text or hex…" FontSize="10" Foreground="{DynamicResource Dim}"
                               Margin="26,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=FindBox, Converter={StaticResource StringEmpty}}" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Find" Style="{StaticResource GhostButton}" FontSize="10.5"
                            FontWeight="Normal" Padding="9,4" Margin="6,0,0,0" Click="Find_Click"
                            ToolTip="Find the next occurrence (Enter)" />
                    <CheckBox x:Name="HexMode" Content="Hex" Style="{StaticResource ObsidianCheckBox}"
                              FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"
                              ToolTip="Interpret the search text as hex bytes with ?? wildcards" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding SourceLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                           Foreground="{DynamicResource Dim}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="14,0,10,0" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Go to" Style="{StaticResource DimText}" VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBox x:Name="GoBox" Style="{StaticResource SearchBox}" Width="110" Padding="8,4,8,4"
                             FontFamily="{StaticResource MonoFont}" FontSize="10.5" KeyDown="GoBox_KeyDown"
                             ToolTip="Offset in hex (0x1A20)" />
                    <Button Content="Go" Style="{StaticResource GhostButton}" FontSize="10.5" FontWeight="Normal"
                            Padding="8,4" Margin="5,0,0,0" Click="Go_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- column header -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceHeader}"
                BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="356" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="OFFSET" Style="{StaticResource TableHeaderText}" />
                <TextBlock Grid.Column="1" Text="00 01 02 03 04 05 06 07 08 09 0A 0B 0C 0D 0E 0F"
                           Style="{StaticResource TableHeaderText}" FontFamily="{StaticResource MonoFont}" FontSize="9" />
                <TextBlock Grid.Column="2" Text="ASCII" Style="{StaticResource TableHeaderText}" />
                <TextBlock x:Name="StatusText" Grid.Column="3" Style="{StaticResource DimText}" FontSize="9.5"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- rows -->
        <ListBox x:Name="Rows" Grid.Row="2" Style="{StaticResource TableList}" Margin="2,2,2,4"
                 SelectionMode="Single" VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="356" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding OffsetText}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                   Foreground="{DynamicResource Dim}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding HexText}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="10.5" Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding AsciiText}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="10.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyState" Grid.Row="2" Text="No bytes to display"
                   Style="{StaticResource DimText}" FontSize="11"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False" />
    </Grid>
</UserControl>
