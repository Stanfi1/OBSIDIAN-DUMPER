<Application x:Class="Obsidian.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Obsidian.Converters"
             xmlns:vm="clr-namespace:Obsidian.ViewModels"
             xmlns:views="clr-namespace:Obsidian.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Index 0 is swapped at runtime by Obsidian.Services.ThemeService
                    (Palette.Dark.xaml / Palette.Light.xaml). Theme.xaml is styles
                    only and always references the palette via DynamicResource.
                -->
                <ResourceDictionary Source="Themes/Palette.Dark.xaml" />
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:CountToVisibilityConverter x:Key="CountToVis" />
            <conv:InverseBooleanConverter x:Key="Not" />
            <conv:StringEmptyToVisibilityConverter x:Key="StringEmpty" />
            <conv:LogLevelBrushConverter x:Key="LevelBrush" />
            <conv:SeverityBrushConverter x:Key="SeverityBrush" />
            <conv:BoolToBrushConverter x:Key="BoolBrush" />
            <conv:PercentageWidthConverter x:Key="PercentWidth" />
            <conv:PercentWidthConverter x:Key="EntropyWidth" />
            <conv:BytesConverter x:Key="Bytes" />

            <DataTemplate DataType="{x:Type vm:TargetsViewModel}">
                <views:TargetsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WorkspaceViewModel}">
                <views:WorkspaceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InspectorViewModel}">
                <views:InspectorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InjectViewModel}">
                <views:InjectView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MemoryViewModel}">
                <views:MemoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogViewModel}">
                <views:LogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
