<UserControl x:Class="Obsidian.Views.InjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Obsidian.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InjectViewModel}"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================ target banner ============================ -->
        <Border Grid.Row="0" Style="{StaticResource CardBare}" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="30" Height="30" CornerRadius="3" Background="{DynamicResource AccentTint}"
                        BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="INJECTION TARGET" Style="{StaticResource LabelCaps}" />
                    <TextBlock Text="{Binding TargetSummary}" FontSize="11.5" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource BadgeCyan}" Margin="0,0,6,0"
                            Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding TargetArch}" FontSize="9"
                                   Foreground="{DynamicResource CyanText}" />
                    </Border>
                    <Border Style="{StaticResource Badge}" Margin="0,0,8,0"
                            Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding TargetPid, StringFormat=pid {0}}" FontSize="9"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{DynamicResource TextDim}" />
                    </Border>
                    <Button Content="Workspace" Style="{StaticResource GhostButton}"
                            Command="{Binding GoToWorkspaceCommand}" Height="26" FontSize="10.5" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ body ============================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.02*" MinWidth="420" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- left: setup form -->
            <Grid Grid.Column="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="14,12">
                            <StackPanel>
                        <TextBlock Text="LIBRARY" Style="{StaticResource LabelCaps}" />
                        <TextBlock Text="Native DLL loaded with LoadLibraryW inside the target."
                                   Style="{StaticResource DimText}" Margin="0,3,0,7" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource SearchBox}"
                                     Text="{Binding DllPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Full path of the DLL to inject" />
                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BrowseDllCommand}" Height="30" Margin="6,0,0,0"
                                    FontSize="11" />
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE838;"
                                    Command="{Binding OpenDllFolderCommand}" ToolTip="Show the file in Explorer"
                                    Height="30" Width="30" Margin="4,0,0,0" />
                        </Grid>

                        <TextBlock Text="{Binding DllInfo}" Style="{StaticResource DimText}" Margin="1,6,0,0"
                                   TextTrimming="CharacterEllipsis" />

                        <Border Background="{DynamicResource AmberTint}" BorderBrush="{DynamicResource BadgeBorderAmber}"
                                BorderThickness="1" CornerRadius="3" Margin="0,8,0,0" Padding="9,6"
                                Visibility="{Binding IsManagedAssembly, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Managed assemblies cannot be loaded by LoadLibrary. Use the MANAGED ASSEMBLY card below to run a .NET Framework entry point."
                                       FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource AmberText}" />
                        </Border>

                        <Border Style="{StaticResource Divider}" Margin="0,12,0,10" />

                        <TextBlock Text="TECHNIQUE" Style="{StaticResource LabelCaps}" />
                        <TextBlock Text="Each option creates the load differently. Start with CreateRemoteThread."
                                   Style="{StaticResource DimText}" Margin="0,3,0,7" />

                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Methods}"
                                 SelectedItem="{Binding SelectedMethod, Mode=TwoWay}"
                                 MaxHeight="174" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:InjectionMethodOption}">
                                    <Grid Margin="4,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource DimText}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Top"
                                                Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Badge}" FontSize="8"
                                                       Foreground="{DynamicResource TextDim}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Style="{StaticResource InsetWell}" Margin="0,6,0,0" Padding="9,7">
                            <TextBlock Text="{Binding MethodDetail}" Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" LineHeight="16" FontSize="10.5" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0"
                                    Visibility="{Binding HasCompatibilityMessage, Converter={StaticResource BoolToVis}}">
                            <Ellipse Width="5" Height="5" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Amber}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompatibleTarget}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Green}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding CompatibilityMessage}" Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" Margin="7,0,0,0" MaxWidth="420" FontSize="10.5" />
                        </StackPanel>

                            </StackPanel>
                        </Border>

                        <!-- run the operation (kept separate so the form never becomes an empty box) -->
                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="OPERATION" Style="{StaticResource LabelCaps}" Margin="0,0,0,8" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding InjectButtonLabel}" Command="{Binding InjectCommand}"
                                            Style="{StaticResource PrimaryButton}" Height="30" MinWidth="168"
                                            IsEnabled="{Binding CanInject}" />
                                    <Button Content="Unload" Command="{Binding UnloadCommand}"
                                            Style="{StaticResource SecondaryButton}" Height="30" Margin="6,0,0,0"
                                            IsEnabled="{Binding CanUnload}" />
                                    <Button Content="Rescan modules" Command="{Binding RescanModulesCommand}"
                                            Style="{StaticResource GhostButton}" Height="30" Margin="6,0,0,0" />
                                </StackPanel>

                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource DimText}"
                                           TextWrapping="Wrap" Margin="0,8,0,0" />

                                <Border Height="1" Background="{DynamicResource Separator}" Margin="0,10" />

                                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" LineHeight="15">
                                    Injection writes into a live process and executes code in it. Only use it on software
                                    you own or are explicitly authorised to analyse. The library must be built for the
                                    target architecture (x86 into x86, x64 into x64).
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="MANAGED ASSEMBLY" Style="{StaticResource LabelCaps}" />
                                <TextBlock Text="Run a .NET Framework 4.x x64 entry point inside the target. The method must be static int Method(string)."
                                           Style="{StaticResource DimText}" Margin="0,3,0,6" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ManagedTargetHint}" Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" Margin="0,0,0,7" FontSize="10" />

                                <TextBlock Text="ASSEMBLY" Style="{StaticResource LabelCaps}" Margin="0,2,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource SearchBox}"
                                             AutomationProperties.AutomationId="ManagedAssemblyPath"
                                             Text="{Binding ManagedAssemblyPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Path to a .NET Framework assembly" />
                                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding BrowseManagedAssemblyCommand}" Height="30" Margin="6,0,0,0"
                                            FontSize="11" />
                                </Grid>
                                <TextBlock Text="{Binding ManagedAssemblyName}" Style="{StaticResource DimText}"
                                           Margin="1,5,0,0" TextTrimming="CharacterEllipsis" />

                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="TYPE" Style="{StaticResource LabelCaps}" Margin="0,0,0,4" />
                                        <TextBox Style="{StaticResource SearchBox}"
                                                 AutomationProperties.AutomationId="ManagedTypeName"
                                                 Text="{Binding ManagedTypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Namespace.Type (for example Namespace.Class)" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="METHOD" Style="{StaticResource LabelCaps}" Margin="0,0,0,4" />
                                        <TextBox Style="{StaticResource SearchBox}"
                                                 AutomationProperties.AutomationId="ManagedMethodName"
                                                 Text="{Binding ManagedMethodName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Static int method taking one string" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="ARGUMENT" Style="{StaticResource LabelCaps}" Margin="0,9,0,4" />
                                <TextBox Style="{StaticResource SearchBox}"
                                         AutomationProperties.AutomationId="ManagedArgument"
                                         Text="{Binding ManagedArgument, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Optional string passed to the managed entry point" />

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Inject managed" Command="{Binding InjectManagedCommand}"
                                            AutomationProperties.AutomationId="InjectManagedButton"
                                            Style="{StaticResource PrimaryButton}" Height="30" MinWidth="148" />
                                    <TextBlock Text="{Binding ManagedStatus}" Style="{StaticResource DimText}"
                                               TextWrapping="Wrap" Margin="10,0,0,0" VerticalAlignment="Center"
                                               MaxWidth="260" />
                                </StackPanel>

                                <Border Background="{DynamicResource AmberTint}" BorderBrush="{DynamicResource BadgeBorderAmber}"
                                        BorderThickness="1" CornerRadius="3" Margin="0,8,0,0" Padding="9,6">
                                    <TextBlock Text="The assembly must be readable by the target process. Dependencies should live next to it. Only .NET Framework 4.x x64 is supported by this host."
                                               FontSize="9.5" TextWrapping="Wrap" Foreground="{DynamicResource AmberText}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- right: result + history -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="RESULT" Style="{StaticResource LabelCaps}" />
                                <Button Content="Copy report" Command="{Binding CopyResultCommand}"
                                        Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Margin="0,-5,0,0" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Dim}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ResultLevel}" Value="Success">
                                                    <Setter Property="Fill" Value="{DynamicResource Green}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ResultLevel}" Value="Error">
                                                    <Setter Property="Fill" Value="{DynamicResource Red}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ResultTitle}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="{Binding ResultDetail}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       Margin="0,5,0,0" LineHeight="16" MaxHeight="84" FontSize="10.5" />

                            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource Divider}" Margin="0,10" />

                                <Grid DataContext="{Binding LastResult}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
                                        <TextBlock Text="METHOD" Style="{StaticResource LabelCaps}" />
                                        <TextBlock Text="{Binding MethodLabel}" Style="{StaticResource MonoText}"
                                                   FontSize="10" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                        <TextBlock Text="MODULE BASE" Style="{StaticResource LabelCaps}" />
                                        <TextBlock Text="{Binding RemoteBaseLabel}" Style="{StaticResource MonoText}"
                                                   FontSize="10" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,8">
                                        <TextBlock Text="WIN32 ERROR" Style="{StaticResource LabelCaps}" />
                                        <TextBlock Text="{Binding Win32Label}" Style="{StaticResource MonoText}"
                                                   FontSize="10" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                        <TextBlock Text="NTSTATUS" Style="{StaticResource LabelCaps}" />
                                        <TextBlock Text="{Binding NtStatusLabel}" Style="{StaticResource MonoText}"
                                                   FontSize="10" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="DURATION" Style="{StaticResource LabelCaps}" />
                                        <TextBlock Text="{Binding DurationLabel}" Style="{StaticResource MonoText}"
                                                   FontSize="10" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1">
                                        <TextBlock Text="TARGET" Style="{StaticResource LabelCaps}" />
                                        <TextBlock Text="{Binding TargetLabel}" Style="{StaticResource MonoText}"
                                                   FontSize="10" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12"
                            MinHeight="360" MaxHeight="480" VerticalAlignment="Top">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="HISTORY" Style="{StaticResource LabelCaps}" VerticalAlignment="Center" />
                                <Button Content="Clear" Command="{Binding ClearHistoryCommand}"
                                        Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Margin="0,-5,0,0" />
                            </Grid>

                            <TextBlock Grid.Row="1" Text="No injections in this session yet."
                                       Style="{StaticResource DimText}" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                            <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding History}"
                                     SelectedItem="{Binding SelectedHistory, Mode=TwoWay}"
                                     Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:InjectionRecord}">
                                        <Grid Height="30">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Red}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Success}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Green}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DllName}" FontSize="11" FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource DimText}" FontSize="9" Margin="0,1,0,0">
                                                    <Run Text="{Binding MethodLabel}" />
                                                    <Run Text="·" />
                                                    <Run Text="{Binding TargetLabel}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TimeLabel}" FontFamily="{StaticResource MonoFont}"
                                                           FontSize="9" Foreground="{DynamicResource Dim}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding OutcomeLabel}" Style="{StaticResource DimText}"
                                                           FontSize="9" HorizontalAlignment="Right" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
