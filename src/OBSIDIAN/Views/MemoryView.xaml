<UserControl x:Class="Obsidian.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True">

    <Grid>
        <!-- no target -->
        <Border Style="{StaticResource Card}" VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="480" Padding="24"
                Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="&#xE950;" FontFamily="{StaticResource IconFont}" FontSize="22"
                           Foreground="{DynamicResource Dim}" HorizontalAlignment="Center" />
                <TextBlock Text="No target attached" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="The memory map, scanner and runtime snapshot operate on a live process. Attach a CLR host from Targets first."
                           FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,6,0,0" MaxWidth="380" />
                <Button Content="Open target list" Style="{StaticResource PrimaryButton}" Width="150" Height="30"
                        Margin="0,14,0,0" Command="{Binding GoToTargetsCommand}" />
            </StackPanel>
        </Border>

        <Grid Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}">
            <TabControl Style="{StaticResource ObsidianTabControl}" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">

                <!-- ============================== map ============================== -->
                <TabItem Header="MAP" Style="{StaticResource ObsidianTab}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <WrapPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="230">
                                    <TextBox Style="{StaticResource SearchBox}" Padding="26,5,8,5" FontSize="10.5"
                                             Text="{Binding RegionFilter, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Foreground="{DynamicResource Dim}" Margin="9,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False" />
                                    <TextBlock Text="Filter base, module, protection…" FontSize="10"
                                               Foreground="{DynamicResource Dim}" Margin="26,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="{Binding RegionFilter, Converter={StaticResource StringEmpty}}" />
                                </Grid>
                                <ToggleButton Style="{StaticResource FilterChip}" Content="Modules"
                                              Margin="6,0,0,0"
                                              ToolTip="Only regions that belong to a loaded module"
                                              IsChecked="{Binding ModulesOnly}" />
                                <ToggleButton Style="{StaticResource FilterChip}" Content="Executable"
                                              Margin="4,0,0,0"
                                              ToolTip="Only executable regions"
                                              IsChecked="{Binding ExecutableOnly}" />
                                <ToggleButton Style="{StaticResource FilterChip}" Content="Suspicious"
                                              Margin="4,0,0,0"
                                              ToolTip="RWX regions and private executable memory"
                                              IsChecked="{Binding SuspiciousOnly}" />
                                <ToggleButton Style="{StaticResource FilterChip}" Content="Reserved"
                                              Margin="4,0,0,0"
                                              ToolTip="Include reserved (uncommitted) address ranges"
                                              IsChecked="{Binding ShowReserved}" />
                            </WrapPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="10,0,0,0">
                                <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Height="28"
                                        FontSize="10.5" Command="{Binding RefreshCommand}" />
                                <Button Content="Hex" Style="{StaticResource GhostButton}" Height="28" FontSize="10.5"
                                        Command="{Binding HexRegionCommand}" Margin="6,0,0,0"
                                        ToolTip="Open the selected region in the hex viewer (first 4 MB)" />
                                <Button Content="Dump region…" Style="{StaticResource GhostButton}" Height="28"
                                        FontSize="10.5" Command="{Binding DumpRegionCommand}" Margin="4,0,0,0"
                                        ToolTip="Write the selected region to a .bin file (max 256 MB)" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding RegionSummary}"
                                       Style="{StaticResource DimText}" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding RegionStatus}"
                                       Margin="0,2,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding RegionStatus, Converter={StaticResource StringEmpty}, ConverterParameter=invert}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DimText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRegionError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource RedText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Border Grid.Row="1" Background="{DynamicResource SurfaceHeader}" />
                        <Grid Grid.Row="1" Margin="10,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="BASE" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="1" Text="SIZE" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="2" Text="PROTECT" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="3" Text="TYPE" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="4" Text="MODULE" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="5" Text="FLAGS" Style="{StaticResource TableHeaderText}" />
                        </Grid>
                        <Border Grid.Row="1" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Separator}" />

                        <Grid Grid.Row="2">
                            <Border Style="{StaticResource CardBare}">
                                <ListBox x:Name="RegionList" Style="{StaticResource TableList}" ItemsSource="{Binding Regions}"
                                         SelectedItem="{Binding SelectedRegion, Mode=TwoWay}" Margin="2,2,2,4"
                                         MouseDoubleClick="RegionList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="24" ToolTip="{Binding ModulePath}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="96" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding BaseLabel}" FontFamily="{StaticResource MonoFont}"
                                                           FontSize="10" Foreground="{DynamicResource TextDim}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding SizeLabel}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding ProtectLabel}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                                           Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding TypeLabel}"
                                                           FontSize="9.5" Foreground="{DynamicResource Dim}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding ModuleLabel}"
                                                           FontSize="10" Foreground="{DynamicResource TextDim}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="5" Text="{Binding FlagsLabel}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSuspicious}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource RedText}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <TextBlock Text="No regions match this filter." Style="{StaticResource DimText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding IsRegionListEmpty, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <Border Grid.Row="3" Style="{StaticResource CardTight}" Padding="10,7" Margin="0,8,0,0">
                            <Grid>
                                <TextBlock Text="{Binding SelectedRegionDetail}" Style="{StaticResource DimText}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Content="Copy base" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Right" Command="{Binding CopyRegionCommand}" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ============================== scan ============================== -->
                <TabItem Header="SCAN" Style="{StaticResource ObsidianTab}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <WrapPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox Style="{StaticResource ObsidianComboBox}" Width="88"
                                          ItemsSource="{Binding ScanKinds}" SelectedItem="{Binding SelectedScanKind}"
                                          ToolTip="Pattern encoding" />
                                <Grid Width="280" Margin="6,0,0,0">
                                    <TextBox Style="{StaticResource SearchBox}" Padding="26,5,8,5" FontSize="10.5"
                                             Text="{Binding ScanPattern, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Text, UTF-16 text, or hex bytes with ?? wildcards (e.g. 48 8B ?? 05)" />
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Foreground="{DynamicResource Dim}" Margin="9,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False" />
                                    <TextBlock Text="Pattern to find…" FontSize="10"
                                               Foreground="{DynamicResource Dim}" Margin="26,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="{Binding ScanPattern, Converter={StaticResource StringEmpty}}" />
                                </Grid>
                                <CheckBox Style="{StaticResource ObsidianCheckBox}" Content="Case-insensitive"
                                          Margin="10,0,0,0" IsChecked="{Binding ScanCaseInsensitive}"
                                          IsEnabled="{Binding IsTextKind}" VerticalAlignment="Center" />
                                <CheckBox Style="{StaticResource ObsidianCheckBox}" Content="Executable only"
                                          Margin="10,0,0,0" IsChecked="{Binding ScanExecutableOnly}"
                                          VerticalAlignment="Center" />
                            </WrapPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="10,0,0,0">
                                <Button Content="Scan" Style="{StaticResource PrimaryButton}" Height="28" Width="78"
                                        FontSize="10.5" Command="{Binding ScanCommand}" />
                                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Height="28"
                                        FontSize="10.5" Margin="6,0,0,0" Command="{Binding CancelScanCommand}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource DimText}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="640" />
                                <ProgressBar Style="{StaticResource ObsidianProgress}" Width="110" Margin="10,0,0,0"
                                             Minimum="0" Maximum="100" Value="{Binding ScanProgress, Mode=OneWay}"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="{DynamicResource SurfaceHeader}" />
                        <Grid Grid.Row="1" Margin="10,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ADDRESS" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="1" Text="MODULE" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="2" Text="CONTEXT" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="3" Text="PROTECT" Style="{StaticResource TableHeaderText}" />
                        </Grid>
                        <Border Grid.Row="1" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Separator}" />

                        <Grid Grid.Row="2">
                            <Border Style="{StaticResource CardBare}">
                                <ListBox x:Name="HitList" Style="{StaticResource TableList}" ItemsSource="{Binding Hits}"
                                         SelectedItem="{Binding SelectedHit, Mode=TwoWay}" Margin="2,2,2,4"
                                         MouseDoubleClick="HitList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding AddressLabel}" FontFamily="{StaticResource MonoFont}"
                                                           FontSize="10" Foreground="{DynamicResource AccentText}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding ModuleLabel}" FontSize="10"
                                                           Foreground="{DynamicResource TextDim}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Preview}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                                           Foreground="{DynamicResource Muted}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="3" Text="{Binding ProtectLabel}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                           Foreground="{DynamicResource Dim}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                           Foreground="{DynamicResource AccentSoft}" HorizontalAlignment="Center" />
                                <TextBlock Text="Scanning memory…" Style="{StaticResource DimText}" Margin="0,8,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{Binding ScanEmptyMessage}"
                                       Style="{StaticResource DimText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="420"
                                       Visibility="{Binding ShowScanEmptyState, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="{Binding ScanError}" FontSize="10"
                                       Foreground="{DynamicResource RedText}" HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom" Margin="0,0,0,8" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="520"
                                       Visibility="{Binding HasScanError, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <Border Grid.Row="3" Style="{StaticResource CardTight}" Padding="10,7" Margin="0,8,0,0">
                            <Grid>
                                <TextBlock Text="{Binding SelectedHitDetail}" Style="{StaticResource DimText}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Margin="0,0,180,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Open hex" Style="{StaticResource LinkButton}"
                                            Command="{Binding OpenHitHexCommand}" />
                                    <Button Content="Copy address" Style="{StaticResource LinkButton}"
                                            Command="{Binding CopyHitCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ============================== runtime ============================== -->
                <TabItem Header="RUNTIME" Style="{StaticResource ObsidianTab}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Capture snapshot" Style="{StaticResource PrimaryButton}" Height="28"
                                    FontSize="10.5" Command="{Binding CaptureRuntimeCommand}"
                                    ToolTip="Read the CLR heap via ClrMD (read-only, max 10 s)" />
                            <Button Grid.Column="2" Content="Cancel" Style="{StaticResource SecondaryButton}" Height="28"
                                    FontSize="10.5" Command="{Binding CancelRuntimeCommand}" />
                            <TextBlock Grid.Column="1" Text="{Binding RuntimeStatus}" Style="{StaticResource DimText}"
                                       VerticalAlignment="Center" Margin="12,0,12,0" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource CardTight}" Margin="0,0,0,8">
                            <UniformGrid Columns="6">
                                <StackPanel>
                                    <TextBlock Text="RUNTIME" Style="{StaticResource LabelCaps}" />
                                    <TextBlock Text="{Binding SnapshotRuntime}" Style="{StaticResource StatValue}"
                                               FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="THREADS" Style="{StaticResource LabelCaps}" />
                                    <TextBlock Text="{Binding SnapshotThreads}" Style="{StaticResource StatValue}"
                                               FontSize="14" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="MODULES" Style="{StaticResource LabelCaps}" />
                                    <TextBlock Text="{Binding SnapshotModules}" Style="{StaticResource StatValue}"
                                               FontSize="14" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="OBJECTS" Style="{StaticResource LabelCaps}" />
                                    <TextBlock Text="{Binding SnapshotObjects}" Style="{StaticResource StatValue}"
                                               FontSize="14" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="HEAP" Style="{StaticResource LabelCaps}" />
                                    <TextBlock Text="{Binding SnapshotHeap}" Style="{StaticResource StatValue}"
                                               FontSize="14" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="HEAP WALK" Style="{StaticResource LabelCaps}" />
                                    <TextBlock Text="{Binding SnapshotWalkable}" Style="{StaticResource StatValue}"
                                               FontSize="11" Margin="0,3,0,0" />
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <Border Grid.Row="2" Background="{DynamicResource SurfaceHeader}" />
                        <Grid Grid.Row="2" Margin="10,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TYPE" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="1" Text="OBJECTS" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="2" Text="SIZE" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="3" Text="SHARE" Style="{StaticResource TableHeaderText}" />
                        </Grid>
                        <Border Grid.Row="2" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Separator}" />

                        <Grid Grid.Row="3">
                            <Border Style="{StaticResource CardBare}">
                                <ListBox Style="{StaticResource TableList}" ItemsSource="{Binding SnapshotTypes}"
                                         Margin="2,2,2,4">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}"
                                                           FontSize="10" Foreground="{DynamicResource TextDim}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           ToolTip="{Binding Name}" />
                                                <TextBlock Grid.Column="1" Text="{Binding CountLabel}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                                           Foreground="{DynamicResource Muted}"
                                                           HorizontalAlignment="Right" Margin="0,0,12,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding SizeLabel}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                                           Foreground="{DynamicResource Dim}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding ShareLabel}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                                           Foreground="{DynamicResource Dim}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <TextBlock Text="Capture a snapshot to list the managed heap by type."
                                       Style="{StaticResource DimText}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding ShowSnapshotEmptyState, Converter={StaticResource BoolToVis}}" />

                            <Border Background="{DynamicResource RedTint}" BorderBrush="{DynamicResource BadgeBorderRed}"
                                    BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,8"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" MaxWidth="560"
                                    Visibility="{Binding HasRuntimeError, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding RuntimeError}" FontSize="10"
                                           Foreground="{DynamicResource RedText}" TextWrapping="Wrap" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding SnapshotWarnings}" VerticalAlignment="Bottom"
                                          HorizontalAlignment="Left" Margin="10" MaxWidth="520">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="9.5"
                                                   Foreground="{DynamicResource AmberText}" TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ============================== carve ============================== -->
                <TabItem Header="CARVE" Style="{StaticResource ObsidianTab}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Style="{StaticResource ObsidianCheckBox}" Content="Include framework assemblies"
                                          IsChecked="{Binding IncludeFrameworkAssemblies}"
                                          ToolTip="Also save System.* and Microsoft.* assemblies found in memory" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Carve &amp; save" Style="{StaticResource PrimaryButton}" Height="28"
                                        FontSize="10.5" Command="{Binding CarveCommand}"
                                        ToolTip="Walk all readable memory for valid .NET assemblies and save them" />
                                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Height="28"
                                        FontSize="10.5" Margin="6,0,0,0" Command="{Binding CancelCarveCommand}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding CarveStatus}" Style="{StaticResource DimText}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="760" />
                                <ProgressBar Style="{StaticResource ObsidianProgress}" Width="110" Margin="10,0,0,0"
                                             Minimum="0" Maximum="100" Value="{Binding CarveProgress, Mode=OneWay}"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding IsCarving, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="{DynamicResource SurfaceHeader}" />
                        <Grid Grid.Row="1" Margin="10,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="66" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ASSEMBLY" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="1" Text="ADDRESS" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="2" Text="SIZE" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="3" Text="METHOD" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="4" Text="FILE" Style="{StaticResource TableHeaderText}" />
                        </Grid>
                        <Border Grid.Row="1" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Separator}" />

                        <Grid Grid.Row="2">
                            <Border Style="{StaticResource CardBare}">
                                <ListBox Style="{StaticResource TableList}" ItemsSource="{Binding CarvedAssemblies}"
                                         Margin="2,2,2,4">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="66" />
                                                    <ColumnDefinition Width="260" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="10"
                                                               Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Name}" />
                                                    <TextBlock Text="{Binding ModuleLabel}" FontSize="9"
                                                               Foreground="{DynamicResource Dim}" Margin="8,0,0,0"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="120" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding AddressLabel}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                                           Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding SizeLabel}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Method}" FontSize="9"
                                                           Foreground="{DynamicResource Dim}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding DetailLabel}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailLabel}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding IsCarving, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                           Foreground="{DynamicResource AccentSoft}" HorizontalAlignment="Center" />
                                <TextBlock Text="Walking memory for assemblies…" Style="{StaticResource DimText}"
                                           Margin="0,8,0,0" HorizontalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="No carved assemblies yet. Carve &amp; save walks every readable region, validates MZ images and writes the managed ones here."
                                       Style="{StaticResource DimText}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                       MaxWidth="520"
                                       Visibility="{Binding ShowCarveEmptyState, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="{Binding CarveError}" FontSize="10"
                                       Foreground="{DynamicResource RedText}" HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom" Margin="0,0,0,8" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="560"
                                       Visibility="{Binding HasCarveError, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <Border Grid.Row="3" Style="{StaticResource CardTight}" Padding="10,7" Margin="0,8,0,0">
                            <Grid>
                                <TextBlock Text="{Binding CarveSummary}" Style="{StaticResource DimText}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Margin="0,0,120,0" />
                                <Button Content="Open folder" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Right" Command="{Binding OpenCarveFolderCommand}" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
