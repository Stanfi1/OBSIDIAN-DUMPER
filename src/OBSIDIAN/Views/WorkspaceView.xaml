<UserControl x:Class="Obsidian.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True">

    <Grid>
        <!-- no target -->
        <Border Style="{StaticResource Card}" VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="440" Padding="24"
                Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="20"
                           Foreground="{DynamicResource Dim}" HorizontalAlignment="Center" />
                <TextBlock Text="No target attached" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Pick a CLR host from the target list to map its modules, dump assemblies and inspect metadata."
                           FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,6,0,0" />
                <Button Content="Open target list" Style="{StaticResource PrimaryButton}" Width="140"
                        Height="30" Margin="0,14,0,0" Command="{Binding GoToTargetsCommand}" />
            </StackPanel>
        </Border>

        <Grid Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============================== target summary ============================== -->
            <Border Grid.Row="0" Style="{StaticResource CardBare}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="14,12,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TargetName}" Style="{StaticResource H2}" />
                                <TextBlock Text="{Binding TargetPid, StringFormat=pid {0}}" Margin="10,2,0,0"
                                           FontFamily="{StaticResource MonoFont}" FontSize="10"
                                           Foreground="{DynamicResource Dim}" VerticalAlignment="Center" />
                                <Border Width="1" Height="11" Background="{DynamicResource SeparatorStrong}"
                                        Margin="8,0" />
                                <TextBlock Text="{Binding TargetArch}" FontSize="10"
                                           Foreground="{DynamicResource CyanText}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TargetRuntime}" FontSize="10"
                                           Foreground="{DynamicResource Muted}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" MaxWidth="170"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetRuntime}" />
                                <TextBlock Text="{Binding TargetIntegrity, StringFormat={}{0} integrity}" FontSize="10"
                                           Foreground="{DynamicResource Muted}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                                <Border Style="{StaticResource BadgeGreen}" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="4" Height="4" Fill="{DynamicResource Green}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="live" FontSize="8.5" Foreground="{DynamicResource GreenText}"
                                                   Margin="4,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding TargetPath}" Style="{StaticResource MonoText}" FontSize="9.5"
                                       Margin="0,6,0,0" TextTrimming="CharacterEllipsis" MaxWidth="820"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding TargetCommandLine}" Style="{StaticResource MonoText}" FontSize="9"
                                       Foreground="{DynamicResource Dim}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="820" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0" Width="174">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding DumpAllCommand}"
                                    Height="30" ToolTip="Dump every managed module in the current filter that is not hidden as framework">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Dump all managed" Margin="7,0,0,0" VerticalAlignment="Center"
                                               FontSize="11.5" />
                                </StackPanel>
                            </Button>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding DumpAllModulesCommand}"
                                        Height="28" FontSize="10.5"
                                        ToolTip="Dump every module of the attached target (honours the Native modules toggle)">
                                    <TextBlock Text="All modules" VerticalAlignment="Center" />
                                </Button>
                                <Button Grid.Column="2" Content="Deep dump" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding DeepDumpCommand}" Height="28" FontSize="10.5"
                                        ToolTip="{Binding DeepDumpHint}" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- metric strip -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0"
                            Padding="14,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TotalCount}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="modules" Style="{StaticResource DimText}" Margin="5,0,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding ManagedCount}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource CyanText}" />
                                <TextBlock Text="managed" Style="{StaticResource DimText}" Margin="5,0,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="{Binding FrameworkCount}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" />
                                <TextBlock Text="framework" Style="{StaticResource DimText}" Margin="5,0,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <TextBlock Text="{Binding InMemoryCount}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Amber}" />
                                <TextBlock Text="in memory" Style="{StaticResource DimText}" Margin="5,0,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <TextBlock Text="{Binding DumpedCount}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Green}" />
                                <TextBlock Text="dumped" Style="{StaticResource DimText}" Margin="5,0,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="5" Orientation="Horizontal">
                                <TextBlock Text="{Binding FailedCount}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Red}" />
                                <TextBlock Text="failed" Style="{StaticResource DimText}" Margin="5,0,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Rescan" Style="{StaticResource GhostButton}"
                                        Command="{Binding RescanCommand}" Height="24" FontSize="10.5"
                                        ToolTip="Re-read the module list of the attached target" />
                                <Button Content="Output folder" Style="{StaticResource GhostButton}"
                                        Command="{Binding OpenOutputCommand}" Height="24" FontSize="10.5"
                                        ToolTip="Open the configured dump output folder" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================== toolbar ============================== -->
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- row 0: find + record filters -->
                <WrapPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="230" Margin="0,2">
                        <TextBox x:Name="ModuleFilterBox" Style="{StaticResource SearchBox}" Padding="28,6,10,6"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                   Foreground="{DynamicResource Dim}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        <TextBlock Text="Find a module…" FontSize="11" Foreground="{DynamicResource Dim}"
                                   Margin="28,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Search, Converter={StaticResource StringEmpty}}" />
                    </Grid>
                    <ToggleButton Style="{StaticResource FilterChip}" Content="Managed only" Margin="8,0,0,0"
                                  ToolTip="Hide native modules (DLLs without a CLR header)"
                                  IsChecked="{Binding ShowManagedOnly}" />
                    <ToggleButton Style="{StaticResource FilterChip}" Content="Hide framework" Margin="4,0,0,0"
                                  ToolTip="Hide .NET framework assemblies such as System.* and mscorlib (also persisted as a dump setting)"
                                  IsChecked="{Binding HideFramework}" />
                    <ToggleButton Style="{StaticResource FilterChip}" Content="Dumped only" Margin="4,0,0,0"
                                  ToolTip="Show only modules that have a dump on disk"
                                  IsChecked="{Binding ShowDumpedOnly}" />
                </WrapPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <TextBlock Text="{Binding SelectedCount}" FontSize="10.5"
                               Foreground="{DynamicResource AccentSoft}" VerticalAlignment="Center" />
                    <TextBlock Text="selected" FontSize="10.5" Foreground="{DynamicResource Dim}" Margin="4,0,8,0"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding DumpSelectedCommand}"
                            Height="28" FontSize="11" Padding="9,4"
                            ToolTip="Dump every selected module (Ctrl+D)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextDim}" />
                            <TextBlock Text="Dump selected" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- row 1: output options + selection helpers + exports -->
                <WrapPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                           Margin="0,6,0,0">
                    <TextBlock Text="OUTPUT" Style="{StaticResource LabelCaps}" VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ToggleButton Style="{StaticResource FilterChip}" Content="Native modules" Margin="0,0,4,0"
                                  ToolTip="Include native modules in dumps (persisted setting)"
                                  IsChecked="{Binding DumpNativeModules}" />
                    <ToggleButton Style="{StaticResource FilterChip}" Content="Raw image" Margin="0,0,4,0"
                                  ToolTip="Write the mapped image instead of rebuilding a PE file (persisted setting)"
                                  IsChecked="{Binding RawImage}" />
                    <ToggleButton Style="{StaticResource FilterChip}" Content="Verify metadata"
                                  ToolTip="Check that a dumped managed module exposes readable metadata (persisted setting)"
                                  IsChecked="{Binding VerifyMetadata}" />
                    <TextBlock Text="{Binding DumpSummaryText}" Style="{StaticResource DimText}"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               Visibility="{Binding HasDumpSummary, Converter={StaticResource BoolToVis}}" />
                </WrapPanel>

                <WrapPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                           Margin="10,6,0,0">
                    <Button Content="Select all" Style="{StaticResource GhostButton}" Command="{Binding SelectAllCommand}"
                            FontSize="10.5" FontWeight="Normal" Padding="6,3"
                            ToolTip="Select every module visible in the current filter" />
                    <Button Content="Invert" Style="{StaticResource GhostButton}" Command="{Binding InvertSelectionCommand}"
                            FontSize="10.5" FontWeight="Normal" Padding="6,3"
                            ToolTip="Invert the module selection" />
                    <Button Content="Clear" Style="{StaticResource GhostButton}" Command="{Binding ClearSelectionCommand}"
                            FontSize="10.5" FontWeight="Normal" Padding="6,3"
                            ToolTip="Clear the module selection" />
                    <Button Content="Clear filters" Style="{StaticResource GhostButton}" Command="{Binding ClearFiltersCommand}"
                            FontSize="10.5" FontWeight="Normal" Padding="6,3"
                            ToolTip="Show every module and clear the search text" />
                    <Border Style="{StaticResource ToolbarSeparator}" Margin="6,0" />
                    <Button Content="CSV" Style="{StaticResource GhostButton}" Command="{Binding ExportCsvCommand}"
                            FontSize="10" FontWeight="Normal" Padding="6,3"
                            ToolTip="Export the current filtered module list as CSV" />
                    <Button Content="JSON" Style="{StaticResource GhostButton}" Command="{Binding ExportJsonCommand}"
                            FontSize="10" FontWeight="Normal" Padding="6,3"
                            ToolTip="Export the current filtered module list as JSON" />
                </WrapPanel>
            </Grid>

            <!-- ============================== table + details ============================== -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.6*" />
                    <ColumnDefinition Width="1*" MinWidth="280" MaxWidth="340" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBare}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource SurfaceHeader}" />
                        <Grid Grid.Row="0" Margin="8,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="68" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MODULE" Grid.Column="1" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Text="KIND" Grid.Column="2" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Text="CLR" Grid.Column="3" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Text="SIZE" Grid.Column="4" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Text="BASE" Grid.Column="5" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Text="STATUS" Grid.Column="6" Style="{StaticResource TableHeaderText}" />
                        </Grid>
                        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Separator}" />

                        <Border Grid.Row="1" Margin="8,6,8,2" CornerRadius="3" Background="{DynamicResource PanelAlt}"
                                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" Padding="10,7"
                                Visibility="{Binding IsDumping, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="{Binding DumpStatusText}" FontSize="10.5"
                                               Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,120,0" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding DumpProgressText}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentSoft}" />
                                        <Button Content="Cancel" Style="{StaticResource GhostButton}"
                                                Command="{Binding CancelDumpCommand}" FontSize="10"
                                                FontWeight="Normal" Padding="6,2" Margin="6,0,0,0"
                                                ToolTip="Stop the dump after the modules that are already in flight" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Grid.Row="1" Style="{StaticResource ObsidianProgress}" Margin="0,6,0,0"
                                             Minimum="0" Maximum="{Binding DumpMax, Mode=OneWay}"
                                             Value="{Binding DumpProgress, Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,2,0,4">
                            <ListBox x:Name="ModuleList" Style="{StaticResource TableList}"
                                     ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                                     SelectionMode="Single"
                                     Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <ListBox.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Dump this module" Command="{Binding DumpModuleCommand}" />
                                        <MenuItem Header="Dump selected native modules" Command="{Binding DumpNativeCommand}" />
                                        <MenuItem Header="Inspect dumped module" Command="{Binding InspectCommand}" />
                                        <Separator />
                                        <MenuItem Header="Open dumped file" Command="{Binding OpenDumpedFileCommand}" />
                                        <MenuItem Header="Select dumped file in Explorer" Command="{Binding OpenDumpedFolderCommand}" />
                                        <Separator />
                                        <MenuItem Header="Copy module path" Command="{Binding CopyModulePathCommand}" />
                                        <MenuItem Header="Copy module name" Command="{Binding CopyModuleNameCommand}" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="32">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="68" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="11.5" FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DisplayPath}" ToolTip="{Binding DisplayPath}" FontSize="9"
                                                           Foreground="{DynamicResource Dim}" TextTrimming="CharacterEllipsis"
                                                           />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding KindLabel}" FontSize="8.5"
                                                       FontWeight="SemiBold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Dim}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsManaged}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource CyanText}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Grid.Column="3" Text="{Binding MetadataLabel}" FontSize="9.5"
                                                       FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Muted}"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="4" Text="{Binding SizeLabel}" FontSize="10"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="5" Text="{Binding AddressLabel}" FontSize="9.5"
                                                       FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Dim}"
                                                       VerticalAlignment="Center" />

                                            <Border Grid.Column="6" HorizontalAlignment="Left" Padding="5,1"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Dumped">
                                                                <Setter Property="Background" Value="{DynamicResource GreenTint}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource BadgeBorderGreen}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter Property="Background" Value="{DynamicResource RedTint}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource BadgeBorderRed}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Dumping">
                                                                <Setter Property="Background" Value="{DynamicResource AmberTint}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource BadgeBorderAmber}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="8" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Muted}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0"
                                        Visibility="{Binding IsModuleListEmpty, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                           Foreground="{DynamicResource Dim}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ModuleEmptyTitle}" FontSize="12"
                                           Foreground="{DynamicResource Muted}" Margin="0,8,0,0"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ModuleEmptyHint}" FontSize="10.5"
                                           Foreground="{DynamicResource Dim}" Margin="0,3,0,0"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                           MaxWidth="320" />
                                <Button Content="Clear filters" Style="{StaticResource GhostButton}"
                                        Command="{Binding ClearFiltersCommand}" Margin="0,8,0,0"
                                        FontSize="10.5" FontWeight="Normal" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- module details -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                       Foreground="{DynamicResource Dim}" HorizontalAlignment="Center" />
                            <TextBlock Text="Select a module" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Dump it to disk, then open it in the inspector for C#, IL and metadata."
                                       FontSize="10.5" Foreground="{DynamicResource Dim}" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="0,5,0,0" MaxWidth="220" />
                        </StackPanel>

                        <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="14,14,14,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="3" Background="{DynamicResource AccentTint}"
                                            BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1">
                                        <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center" MaxWidth="220">
                                        <TextBlock Text="{Binding Selected.Name}" FontSize="12.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Selected.KindLabel}" FontSize="9.5"
                                                   Foreground="{DynamicResource Dim}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="{Binding SelectedModulePath}" Style="{StaticResource MonoText}" ToolTip="{Binding SelectedModulePath}"
                                           FontSize="9" TextWrapping="Wrap" Margin="0,10,0,0" MaxHeight="48" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="14,10,8,0">
                                <StackPanel>
                                    <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,12,0" Text="Base address" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Selected.AddressLabel}" Style="{StaticResource FieldValueMono}" />
                                </Grid>
                                    <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,12,0" Text="Mapped size" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Selected.SizeLabel}" Style="{StaticResource FieldValueMono}" />
                                </Grid>
                                    <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,12,0" Text="Metadata" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Selected.MetadataLabel}" Style="{StaticResource FieldValueMono}" />
                                </Grid>
                                    <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,12,0" Text="Status" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedStatusText}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                    <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,12,0" Text="Framework" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedFrameworkText}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                    <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,12,0" Text="In memory only" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedInMemoryText}" Style="{StaticResource FieldValue}" />
                                </Grid>

                                    <Border Style="{StaticResource Divider}" Margin="0,8" />

                                    <TextBlock Text="OUTPUT" Style="{StaticResource LabelCaps}" />
                                    <Border Style="{StaticResource InsetWell}" Padding="8" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding SelectedModuleOutput}" Style="{StaticResource MonoText}"
                                                   FontSize="8.5" TextWrapping="Wrap" MaxHeight="58" />
                                    </Border>

                                    <Border Style="{StaticResource Divider}" Margin="0,8" />

                                    <TextBlock Text="NOTES" Style="{StaticResource LabelCaps}" />
                                    <TextBlock Text="{Binding SelectedModuleNote}" FontSize="10"
                                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2" Margin="14,10,14,14">
                                <Button Content="Dump this module" Style="{StaticResource PrimaryButton}" Height="30"
                                        Command="{Binding DumpModuleCommand}"
                                        ToolTip="Dump the selected module to the configured output folder" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Inspect" Style="{StaticResource SecondaryButton}" Height="28"
                                            FontSize="11" Command="{Binding InspectCommand}"
                                            ToolTip="Dump (if needed) and open the module in the Inspector" />
                                    <Button Grid.Column="2" Content="Reveal file" Style="{StaticResource SecondaryButton}"
                                            Height="28" FontSize="11" Command="{Binding RevealCommand}"
                                            ToolTip="Select the dumped file in File Explorer" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Open dump" Style="{StaticResource SecondaryButton}" Height="28"
                                            FontSize="11" Command="{Binding OpenDumpedFileCommand}"
                                            ToolTip="Open a managed dump in the Inspector; native dumps are only selected in Explorer" />
                                    <Button Grid.Column="2" Content="Open folder" Style="{StaticResource SecondaryButton}"
                                            Height="28" FontSize="11" Command="{Binding OpenDumpedFolderCommand}"
                                            ToolTip="Show the dumped file in File Explorer" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

