<UserControl x:Class="Obsidian.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- ================================================== left column -->
            <StackPanel Grid.Column="0">

                <!-- appearance -->
                <Border Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="APPEARANCE" Style="{StaticResource LabelCaps}" />
                        <TextBlock Text="Applies instantly; every choice is saved for the next session."
                                   Style="{StaticResource DimText}" Margin="0,3,0,10" TextWrapping="Wrap" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Theme" FontSize="11.5" />
                                <TextBlock Text="{Binding ThemeSummary}" Style="{StaticResource DimText}"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton Style="{StaticResource FilterChip}" Content="System"
                                              IsChecked="{Binding IsSystemTheme, Mode=OneWay}" Margin="0,0,4,0"
                                              Command="{Binding SelectThemeCommand}" CommandParameter="System"
                                              AutomationProperties.Name="Follow the Windows theme" />
                                <ToggleButton Style="{StaticResource FilterChip}" Content="Dark"
                                              IsChecked="{Binding IsDarkTheme, Mode=OneWay}" Margin="0,0,4,0"
                                              Command="{Binding SelectThemeCommand}" CommandParameter="Dark"
                                              AutomationProperties.Name="Always use the dark theme" />
                                <ToggleButton Style="{StaticResource FilterChip}" Content="Light"
                                              IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                                              Command="{Binding SelectThemeCommand}" CommandParameter="Light"
                                              AutomationProperties.Name="Always use the light theme" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Separator}" Margin="0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Accent" FontSize="11.5" />
                                <TextBlock Text="{Binding AccentLabel}" Style="{StaticResource DimText}"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding AccentOptions}"
                                          VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Ring" CornerRadius="3" BorderThickness="1"
                                                BorderBrush="Transparent" Padding="2" Margin="0,0,6,0">
                                            <Button Style="{StaticResource GhostButton}" Padding="0" Width="24"
                                                    Height="24" Cursor="Hand"
                                                    Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Preset}"
                                                    ToolTip="{Binding Label}"
                                                    AutomationProperties.Name="{Binding Label}">
                                                <Border Width="14" Height="14" CornerRadius="2"
                                                        Background="{Binding Swatch}" />
                                            </Button>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Ring" Property="BorderBrush"
                                                        Value="{DynamicResource AccentBorderStrong}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Separator}" Margin="0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Density" FontSize="11.5" />
                                <TextBlock Text="Compact tightens paddings, row heights and page margins."
                                           Style="{StaticResource DimText}" Margin="0,1,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton Style="{StaticResource FilterChip}" Content="Comfortable"
                                              IsChecked="{Binding IsComfortableDensity, Mode=OneWay}" Margin="0,0,4,0"
                                              Command="{Binding SelectDensityCommand}" CommandParameter="Comfortable"
                                              AutomationProperties.Name="Comfortable density" />
                                <ToggleButton Style="{StaticResource FilterChip}" Content="Compact"
                                              IsChecked="{Binding IsCompactDensity, Mode=OneWay}"
                                              Command="{Binding SelectDensityCommand}" CommandParameter="Compact"
                                              AutomationProperties.Name="Compact density" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Separator}" Margin="0,10" />

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding Animations}"
                                  Content="Page transitions" />
                        <TextBlock Text="Subtle fade and slide between pages and toasts."
                                   Style="{StaticResource DimText}" Margin="22,2,0,0" />

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding ShowEngineVersions}"
                                  Content="Show engine versions in the sidebar" Margin="0,9,0,0" />
                        <TextBlock Text="Hides the dnlib / ILSpy / runtime block when you want a quieter shell."
                                   Style="{StaticResource DimText}" Margin="22,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- dumping -->
                <Border Style="{StaticResource Card}" Padding="14,12"
                        Margin="{DynamicResource SettingsSectionSpacing}">
                    <StackPanel>
                        <TextBlock Text="DUMPING" Style="{StaticResource LabelCaps}" />
                        <TextBlock Text="Applied to every new dump. Safe defaults keep rebuilt images loadable."
                                   Style="{StaticResource DimText}" Margin="0,3,0,10" TextWrapping="Wrap" />

                        <TextBlock Text="OUTPUT DIRECTORY" Style="{StaticResource LabelCaps}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource SearchBox}" FontSize="10.5" Padding="9,6"
                                     Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                     AutomationProperties.Name="Dump output directory" />
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}"
                                    Height="30" Margin="6,0,0,0" FontSize="10.5"
                                    Command="{Binding BrowseOutputCommand}"
                                    AutomationProperties.Name="Browse for output directory" />
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8B7;"
                                    Margin="4,0,0,0" Command="{Binding OpenOutputCommand}" ToolTip="Open folder"
                                    AutomationProperties.Name="Open output folder" />
                        </Grid>
                        <TextBlock Text="{Binding OutputDirectoryHint}" Style="{StaticResource DimText}"
                                   Margin="0,4,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="FILE NAME TEMPLATE" Style="{StaticResource LabelCaps}" Margin="0,12,0,0" />
                        <TextBox Style="{StaticResource SearchBox}" FontSize="10.5" Padding="9,6" Margin="0,4,0,0"
                                 Text="{Binding FileNameTemplate, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                 ToolTip="Tokens: {name} {pid} {base} {ext} {module}"
                                 AutomationProperties.Name="Dump file name template" />
                        <TextBlock Text="{}{name} · {pid} · {base} · {ext} · {module}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="9"
                                   Foreground="{DynamicResource Dim}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding FileNamePreview}" Style="{StaticResource DimText}" Margin="0,3,0,0"
                                   FontFamily="{StaticResource MonoFont}" FontSize="10" />
                        <TextBlock Text="{Binding FileNamePreviewHint}" FontSize="10"
                                   Foreground="{DynamicResource AmberText}" Margin="0,3,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasFileNamePreviewHint, Converter={StaticResource BoolToVis}}" />

                        <Border Style="{StaticResource Divider}" Margin="0,12,0,8" />
                        <TextBlock Text="PE REBUILD" Style="{StaticResource LabelCaps}" />

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding RebuildPe}"
                                  Content="Rebuild PE headers and sections" Margin="0,7,0,0" />
                        <TextBlock Text="Reconstructs a loadable on-disk image from the mapped memory image."
                                   Style="{StaticResource DimText}" Margin="22,2,0,0" TextWrapping="Wrap" />

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding VerifyMetadata}"
                                  Content="Verify metadata after dump" Margin="0,7,0,0" />
                        <TextBlock Text="Loads the rebuilt image with dnlib and reports type/method counts."
                                   Style="{StaticResource DimText}" Margin="22,2,0,0" TextWrapping="Wrap" />

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding RepairMetadata}"
                                  Content="Repair metadata from the live CLR" Margin="0,7,0,0" />
                        <TextBlock Text="When a dump has a wiped COR20 directory or BSJB signature, copy the runtime metadata back through ClrMD."
                                   Style="{StaticResource DimText}" Margin="22,2,0,0" TextWrapping="Wrap" />

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding InvalidateStrongName}"
                                  Content="Invalidate strong-name signature" Margin="0,7,0,0" />
                        <TextBlock Text="A memory dump cannot carry a valid signature; clearing it keeps loaders quiet."
                                   Style="{StaticResource DimText}" Margin="22,2,0,0" TextWrapping="Wrap" />

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding StripDebugDirectory}"
                                  Content="Strip stale debug directory" Margin="0,7,0,0" />
                        <TextBlock Text="Removes RSDS paths that point at the build machine."
                                   Style="{StaticResource DimText}" Margin="22,2,0,0" />

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding StripBoundImports}"
                                  Content="Strip bound imports" Margin="0,7,0,0" />
                        <TextBlock Text="Drops bound-import metadata whose addresses no longer match the rebuilt file."
                                   Style="{StaticResource DimText}" Margin="22,2,0,0" TextWrapping="Wrap" />

                        <Border Style="{StaticResource Divider}" Margin="0,12,0,8" />
                        <TextBlock Text="SCOPE" Style="{StaticResource LabelCaps}" />

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding HideFrameworkModules}"
                                  Content="Hide framework modules in the workspace" Margin="0,7,0,0" />
                        <TextBlock Text="Runtime assemblies are noise unless you are hunting a specific patched framework file."
                                   Style="{StaticResource DimText}" Margin="22,2,0,0" TextWrapping="Wrap" />

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding DumpNativeModules}"
                                  Content="Allow native module dumping" Margin="0,7,0,0" />
                        <TextBlock Text="The same PE rebuild also works for unmanaged images."
                                   Style="{StaticResource DimText}" Margin="22,2,0,0" />

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding RawImage}"
                                  Content="Raw image mode (forensics)" Margin="0,7,0,0" />
                        <TextBlock Text="Writes the mapped image untouched. Headers keep mapped RVAs; useful for broken layouts."
                                   Style="{StaticResource DimText}" Margin="22,2,0,0" TextWrapping="Wrap" />

                        <Border Style="{StaticResource Divider}" Margin="0,12,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="When the output file exists" FontSize="11.5" />
                                <TextBlock Text="{Binding SelectedOverwritePolicy.Description}"
                                           Style="{StaticResource DimText}" Margin="0,1,0,0" TextWrapping="Wrap"
                                           MaxWidth="380" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource ObsidianComboBox}" Width="130"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding OverwritePolicyChoices}"
                                      SelectedItem="{Binding SelectedOverwritePolicy}"
                                      AutomationProperties.Name="Overwrite policy" />
                        </Grid>

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding ConfirmOverwrite}"
                                  Content="Ask before overwriting a dump" Margin="0,9,0,0" />
                        <TextBlock Text="Shows a confirmation when a dump would replace an existing file (workspace page)."
                                   Style="{StaticResource DimText}" Margin="22,2,0,0" TextWrapping="Wrap" />

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding AutoOpenOutputFolder}"
                                  Content="Open the output folder after a successful dump" Margin="0,7,0,0" />

                        <Border Style="{StaticResource Divider}" Margin="0,12,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Parallel dump workers" FontSize="11.5" />
                                <TextBlock Text="1–8 modules are dumped at the same time; 4 is a good default for large targets."
                                           Style="{StaticResource DimText}" Margin="0,1,0,0" TextWrapping="Wrap"
                                           MaxWidth="380" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource ObsidianComboBox}" Width="80"
                                      VerticalAlignment="Center" ItemsSource="{Binding ParallelThreadOptions}"
                                      SelectedItem="{Binding ParallelDumpThreads}"
                                      AutomationProperties.Name="Parallel dump workers" />
                        </Grid>

                        <TextBlock Text="DEEP-DUMP WORK DIRECTORY" Style="{StaticResource LabelCaps}" Margin="0,12,0,0" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource SearchBox}" FontSize="10.5" Padding="9,6"
                                     Text="{Binding DeepDumpWorkDirectory, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                     AutomationProperties.Name="Deep dump work directory" />
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}"
                                    Height="30" Margin="6,0,0,0" FontSize="10.5"
                                    Command="{Binding BrowseDeepDumpDirectoryCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding DeepDumpWorkDirectoryHint}" Style="{StaticResource DimText}"
                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- processes -->
                <Border Style="{StaticResource Card}" Padding="14,12"
                        Margin="{DynamicResource SettingsSectionSpacing}">
                    <StackPanel>
                        <TextBlock Text="PROCESSES" Style="{StaticResource LabelCaps}" />
                        <TextBlock Text="How the Targets page scans and displays processes."
                                   Style="{StaticResource DimText}" Margin="0,3,0,10" TextWrapping="Wrap" />

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding ShowInaccessibleProcesses}"
                                  Content="Show processes the shell cannot open" />
                        <TextBlock Text="Protected and elevated targets stay visible; attaching will explain why it cannot read them."
                                   Style="{StaticResource DimText}" Margin="22,2,0,0" TextWrapping="Wrap" />

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding LazyCommandLine}"
                                  Content="Load command lines lazily" Margin="0,9,0,0" />
                        <TextBlock Text="Reads the PEB command line only for the selected process instead of every row."
                                   Style="{StaticResource DimText}" Margin="22,2,0,0" TextWrapping="Wrap" />

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding RememberFilters}"
                                  Content="Remember filters and selection between sessions" Margin="0,9,0,0" />
                        <TextBlock Text="Restores the last Targets/Workspace search and filter when OBSIDIAN starts."
                                   Style="{StaticResource DimText}" Margin="22,2,0,0" TextWrapping="Wrap" />

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding ConfirmDestructiveActions}"
                                  Content="Confirm suspend / resume / terminate actions" Margin="0,9,0,0" />
                        <TextBlock Text="The Targets context menu asks before it changes process state."
                                   Style="{StaticResource DimText}" Margin="22,2,0,0" TextWrapping="Wrap" />

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding HighlightElevated}"
                                  Content="Highlight elevated processes" Margin="0,9,0,0" />

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding ShowIntegrity}"
                                  Content="Show the integrity level column" Margin="0,9,0,0" />

                        <Border Style="{StaticResource Divider}" Margin="0,12,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Auto-refresh" FontSize="11.5" />
                                <TextBlock Text="Background rescan of the process list while the Targets page is open."
                                           Style="{StaticResource DimText}" Margin="0,1,0,0" TextWrapping="Wrap"
                                           MaxWidth="380" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource ObsidianComboBox}" Width="150"
                                      VerticalAlignment="Center" ItemsSource="{Binding AutoRefreshChoices}"
                                      SelectedItem="{Binding SelectedAutoRefresh}"
                                      AutomationProperties.Name="Automatic process refresh interval" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- injection -->
                <Border Style="{StaticResource Card}" Padding="14,12"
                        Margin="{DynamicResource SettingsSectionSpacing}">
                    <StackPanel>
                        <TextBlock Text="INJECTION" Style="{StaticResource LabelCaps}" />
                        <TextBlock Text="Defaults used by the Injection page."
                                   Style="{StaticResource DimText}" Margin="0,3,0,10" TextWrapping="Wrap" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Default method" FontSize="11.5" />
                                <TextBlock Text="{Binding SelectedInjectionMethod.Description}"
                                           Style="{StaticResource DimText}" Margin="0,1,0,0" TextWrapping="Wrap"
                                           MaxWidth="380" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource ObsidianComboBox}" Width="160"
                                      VerticalAlignment="Center" ItemsSource="{Binding InjectionMethodChoices}"
                                      SelectedItem="{Binding SelectedInjectionMethod}"
                                      AutomationProperties.Name="Default injection method" />
                        </Grid>

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding ConfirmInjection}"
                                  Content="Ask before injecting a library" Margin="0,9,0,0" />
                        <TextBlock Text="A confirmation dialog explains the target, method and DLL before the call."
                                   Style="{StaticResource DimText}" Margin="22,2,0,0" TextWrapping="Wrap" />

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding AutoUnloadOnDetach}"
                                  Content="Unload injected libraries when detaching" Margin="0,9,0,0" />
                        <TextBlock Text="Runs FreeLibrary for every library this session injected into the target."
                                   Style="{StaticResource DimText}" Margin="22,2,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="REMEMBERED DLL FOLDER" Style="{StaticResource LabelCaps}" Margin="0,12,0,0" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource SearchBox}" FontSize="10.5" Padding="9,6"
                                     Text="{Binding InjectionDllDirectory, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                     AutomationProperties.Name="Remembered injection DLL folder" />
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}"
                                    Height="30" Margin="6,0,0,0" FontSize="10.5"
                                    Command="{Binding BrowseInjectionDirectoryCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding InjectionDllDirectoryHint}" Style="{StaticResource DimText}"
                                   Margin="0,4,0,0" TextWrapping="Wrap" />

                        <Border Background="{DynamicResource AmberTint}" BorderBrush="{DynamicResource BadgeBorderAmber}"
                                BorderThickness="1" CornerRadius="3" Margin="0,10,0,0" Padding="9,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           Foreground="{DynamicResource AmberText}" VerticalAlignment="Center" />
                                <TextBlock Text="Managed assemblies are loadable, but managed code runs inside the target and may be detected."
                                           FontSize="10" Foreground="{DynamicResource AmberText}"
                                           TextWrapping="Wrap" Margin="7,0,0,0" MaxWidth="460" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- activity -->
                <Border Style="{StaticResource Card}" Padding="14,12"
                        Margin="{DynamicResource SettingsSectionSpacing}">
                    <StackPanel>
                        <TextBlock Text="ACTIVITY" Style="{StaticResource LabelCaps}" />
                        <TextBlock Text="The engine log shown on the Activity page."
                                   Style="{StaticResource DimText}" Margin="0,3,0,10" TextWrapping="Wrap" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Maximum entries" FontSize="11.5" />
                                <TextBlock Text="The in-memory ring buffer uses this size on the next start; the Activity page trims immediately."
                                           Style="{StaticResource DimText}" Margin="0,1,0,0" TextWrapping="Wrap"
                                           MaxWidth="380" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource ObsidianComboBox}" Width="110"
                                      VerticalAlignment="Center" ItemsSource="{Binding MaxLogEntriesOptions}"
                                      SelectedItem="{Binding MaxLogEntries}"
                                      AutomationProperties.Name="Maximum activity log entries" />
                        </Grid>

                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Minimum level" FontSize="11.5" />
                            <ComboBox Grid.Column="1" Style="{StaticResource ObsidianComboBox}" Width="130"
                                      VerticalAlignment="Center" ItemsSource="{Binding LogLevels}"
                                      SelectedItem="{Binding LogMinLevel}"
                                      AutomationProperties.Name="Minimum activity log level" />
                        </Grid>

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding LogShowTimestamps}"
                                  Content="Show timestamps" Margin="0,9,0,0" />

                        <CheckBox Style="{StaticResource ObsidianCheckBox}" IsChecked="{Binding LogAutoScroll}"
                                  Content="Auto-scroll to new entries" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================================================= right column -->
            <StackPanel Grid.Column="2">

                <!-- about -->
                <Border Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/obsidian-mark.png" Width="32" Height="32"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="OBSIDIAN" FontFamily="{StaticResource DisplayFont}" FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock Text=".NET dumper" Style="{StaticResource DimText}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="A read-only .NET assembly dumper: memory-image reconstruction, managed agent for hidden modules, and an ILSpy-powered inspector."
                                   FontSize="10.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                   Margin="0,10,0,0" LineHeight="16" />

                        <Border Style="{StaticResource Divider}" Margin="0,10" />

                        <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,12,0" Text="Version" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding VersionText}" Style="{StaticResource FieldValue}" />
                                </Grid>
                        <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,12,0" Text="Engine" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding EngineText}" Style="{StaticResource FieldValueMono}" />
                                </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Settings" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding SettingsPath}" MaxWidth="220"
                                       FontFamily="{StaticResource MonoFont}" FontSize="9"
                                       Foreground="{DynamicResource Dim}" HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Output" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding EffectiveOutputDirectory}" MaxWidth="220"
                                       FontFamily="{StaticResource MonoFont}" FontSize="9"
                                       Foreground="{DynamicResource Dim}" HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Reset defaults" Style="{StaticResource SecondaryButton}" Height="28"
                                    FontSize="10.5" Command="{Binding ResetCommand}" />
                            <Button Content="Open output folder" Style="{StaticResource GhostButton}" Height="28"
                                    FontSize="10.5" Margin="6,0,0,0" Command="{Binding OpenOutputCommand}"
                                    ToolTip="Open the folder where dumps are written" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- diagnostics -->
                <Border Style="{StaticResource CardTight}" Margin="{DynamicResource SettingsSectionSpacing}">
                    <StackPanel>
                        <TextBlock Text="DIAGNOSTICS" Style="{StaticResource LabelCaps}" />
                        <TextBlock Text="Paths and versions used by the current run."
                                   Style="{StaticResource DimText}" Margin="0,3,0,8" TextWrapping="Wrap" />

                        <TextBlock Text="Settings file" Style="{StaticResource DimText}" />
                        <TextBlock Text="{Binding SettingsPath}" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                   Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SettingsPath}" />
                        <TextBlock Text="Output folder" Style="{StaticResource DimText}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding EffectiveOutputDirectory}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="9" Foreground="{DynamicResource Muted}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding EffectiveOutputDirectory}" />
                        <TextBlock Text="Engine" Style="{StaticResource DimText}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding EngineText}" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                   Foreground="{DynamicResource Muted}" />

                        <Border Background="{DynamicResource RedTint}" BorderBrush="{DynamicResource BadgeBorderRed}"
                                BorderThickness="1" CornerRadius="3" Margin="0,8,0,0" Padding="8,5"
                                Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding LoadErrorText}" FontSize="9.5"
                                       Foreground="{DynamicResource RedText}" TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Copy diagnostics" Style="{StaticResource SecondaryButton}" Height="26"
                                    FontSize="10" Command="{Binding CopyDiagnosticsCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Open settings folder" Style="{StaticResource GhostButton}" Height="26"
                                    FontSize="10" Command="{Binding OpenSettingsFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- legal -->
                <Border Style="{StaticResource CardTight}" Margin="{DynamicResource SettingsSectionSpacing}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{DynamicResource Amber}" VerticalAlignment="Center" />
                            <TextBlock Text="LEGAL &amp; SAFETY" Style="{StaticResource LabelCaps}" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource Muted}"
                                   LineHeight="15" Margin="0,6,0,0">
                            OBSIDIAN is an analysis tool for software you own or are authorised to assess. The
                            inspection engine only reads target memory. The managed agent is optional, requires an
                            explicit action, and writes its output to the directory you choose. Do not use it to
                            bypass licensing on software you do not own.
                        </TextBlock>
                        <Button Content="Third-party notices" Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Left" Margin="0,4,0,0"
                                Command="{Binding OpenThirdPartyNoticesCommand}" />
                    </StackPanel>
                </Border>

                <!-- shortcuts -->
                <Border Style="{StaticResource CardTight}" Margin="{DynamicResource SettingsSectionSpacing}">
                    <StackPanel>
                        <TextBlock Text="SHORTCUTS" Style="{StaticResource LabelCaps}" />
                        <Grid Margin="0,7,0,0">
                            <TextBlock Text="Refresh view" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource KeyCap}" HorizontalAlignment="Right">
                                <TextBlock Text="F5" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                                           Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                        <Grid Margin="0,5,0,0">
                            <TextBlock Text="Switch pages" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource KeyCap}" HorizontalAlignment="Right">
                                <TextBlock Text="Ctrl+1…7" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                                           Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                        <Grid Margin="0,5,0,0">
                            <TextBlock Text="Dismiss toasts" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource KeyCap}" HorizontalAlignment="Right">
                                <TextBlock Text="Esc" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                                           Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                        <Grid Margin="0,5,0,0">
                            <TextBlock Text="Attach selected target" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource KeyCap}" HorizontalAlignment="Right">
                                <TextBlock Text="Dbl-click" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                                           Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
