<UserControl x:Class="Obsidian.Views.TargetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <!-- Sortable column header: same treatment as TableHeaderText, but clickable. -->
        <Style x:Key="ColumnHeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Dim}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================== metrics strip ============================== -->
        <Border Grid.Row="0" Style="{StaticResource CardBare}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="14,10,14,10">
                    <TextBlock Text="PROCESSES" Style="{StaticResource LabelCaps}" />
                    <TextBlock Text="{Binding TotalCount}" Style="{StaticResource StatValue}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding ScanSummary}" Style="{StaticResource DimText}" Margin="0,1,0,0" />
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource Separator}" Margin="0,10" />

                <StackPanel Grid.Column="2" Margin="14,10,14,10">
                    <TextBlock Text="MANAGED CLR" Style="{StaticResource LabelCaps}" />
                    <TextBlock Text="{Binding ManagedCount}" Style="{StaticResource StatValue}"
                               Foreground="{DynamicResource CyanText}" Margin="0,3,0,0" />
                    <TextBlock Text="CLR hosts" Style="{StaticResource DimText}" Margin="0,1,0,0" />
                </StackPanel>

                <Border Grid.Column="3" Background="{DynamicResource Separator}" Margin="0,10" />

                <StackPanel Grid.Column="4" Margin="14,10,14,10">
                    <TextBlock Text="ELEVATED" Style="{StaticResource LabelCaps}" />
                    <TextBlock Text="{Binding ElevatedCount}" Style="{StaticResource StatValue}"
                               Foreground="{DynamicResource AmberText}" Margin="0,3,0,0" />
                    <TextBlock Text="higher integrity" Style="{StaticResource DimText}" Margin="0,1,0,0" />
                </StackPanel>

                <Border Grid.Column="5" Background="{DynamicResource Separator}" Margin="0,10" />

                <StackPanel Grid.Column="6" Margin="14,10,14,10">
                    <TextBlock Text="64-BIT" Style="{StaticResource LabelCaps}" />
                    <TextBlock Text="{Binding X64Count}" Style="{StaticResource StatValue}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding X86Count, StringFormat={}x86: {0}}" Style="{StaticResource DimText}"
                               Margin="0,1,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== toolbar ============================== -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="250">
                    <TextBox x:Name="FilterBox" Style="{StaticResource SearchBox}" Padding="28,6,10,6"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{DynamicResource Dim}" Margin="10,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                    <TextBlock Text="Filter name, pid, company, runtime…" FontSize="11"
                               Foreground="{DynamicResource Dim}" Margin="28,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding Search, Converter={StaticResource StringEmpty}}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                    <ToggleButton Style="{StaticResource FilterChip}" Content="All" Margin="0,0,4,0"
                                  ToolTip="Every process on the machine"
                                  IsChecked="{Binding IsAllFilter, Mode=OneWay}"
                                  Command="{Binding SetFilterCommand}" CommandParameter="all" />
                    <ToggleButton Style="{StaticResource FilterChip}" Content="Managed" Margin="0,0,4,0"
                                  ToolTip="Processes that host a CLR runtime"
                                  IsChecked="{Binding IsManagedFilter, Mode=OneWay}"
                                  Command="{Binding SetFilterCommand}" CommandParameter="managed" />
                    <ToggleButton Style="{StaticResource FilterChip}" Content="x86" Margin="0,0,4,0"
                                  ToolTip="32-bit processes"
                                  IsChecked="{Binding IsX86Filter, Mode=OneWay}"
                                  Command="{Binding SetFilterCommand}" CommandParameter="x86" />
                    <ToggleButton Style="{StaticResource FilterChip}" Content="x64" Margin="0,0,4,0"
                                  ToolTip="64-bit processes"
                                  IsChecked="{Binding IsX64Filter, Mode=OneWay}"
                                  Command="{Binding SetFilterCommand}" CommandParameter="x64" />
                    <ToggleButton Style="{StaticResource FilterChip}" Content="Elevated"
                                  ToolTip="Processes running with high or system integrity"
                                  IsChecked="{Binding IsElevatedFilter, Mode=OneWay}"
                                  Command="{Binding SetFilterCommand}" CommandParameter="elevated" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ScanStatusText}" FontSize="10.5"
                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" Command="{Binding CancelScanCommand}"
                            FontSize="10.5" FontWeight="Normal" Padding="7,3" Margin="6,0,0,0"
                            ToolTip="Cancel the running process scan" />
                </StackPanel>

                <ToggleButton Style="{StaticResource FilterChip}" Content="Auto"
                              IsChecked="{Binding IsAutoRefreshEnabled, Mode=OneWay}"
                              Command="{Binding ToggleAutoRefreshCommand}"
                              ToolTip="{Binding AutoRefreshHint}" />
                <Button Style="{StaticResource GhostButton}" Content="{Binding AutoRefreshLabel}"
                        Command="{Binding CycleAutoRefreshCommand}" FontSize="10" FontWeight="Normal"
                        Padding="6,3" Margin="3,0,0,0"
                        ToolTip="Change the auto-refresh interval (2 s → 5 s → 10 s → 30 s → off)" />

                <Button Content="CSV" Style="{StaticResource GhostButton}" Command="{Binding ExportCsvCommand}"
                        FontSize="10" FontWeight="Normal" Padding="6,3" Margin="8,0,0,0"
                        ToolTip="Export the current filtered process view as CSV" />
                <Button Content="JSON" Style="{StaticResource GhostButton}" Command="{Binding ExportJsonCommand}"
                        FontSize="10" FontWeight="Normal" Padding="6,3"
                        ToolTip="Export the current filtered process view as JSON" />

                <Border Style="{StaticResource ToolbarSeparator}" Margin="8,0" />

                <TextBlock Text="{Binding VisibleCountLabel}" FontSize="10.5"
                           Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                <TextBlock Text="shown" FontSize="10.5" Foreground="{DynamicResource Dim}" Margin="4,0,10,0"
                           VerticalAlignment="Center" />

                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"
                        Height="28" Padding="9,4" ToolTip="Rescan the machine (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                        <TextBlock Text="Rescan" Margin="6,0,0,0" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================== table + details ============================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" MinWidth="280" MaxWidth="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBare}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource SurfaceHeader}" />
                    <Grid Grid.Row="0" Margin="8,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource ColumnHeaderButton}" Content="{Binding PidHeader}"
                                Command="{Binding SortByCommand}" CommandParameter="Pid" ToolTip="Sort by process id" />
                        <Button Grid.Column="1" Style="{StaticResource ColumnHeaderButton}"
                                Content="{Binding ProcessHeader}"
                                Command="{Binding SortByCommand}" CommandParameter="Process" ToolTip="Sort by process name" />
                        <Button Grid.Column="2" Style="{StaticResource ColumnHeaderButton}"
                                Content="{Binding RuntimeHeader}"
                                Command="{Binding SortByCommand}" CommandParameter="Runtime" ToolTip="Sort by CLR runtime" />
                        <Button Grid.Column="3" Style="{StaticResource ColumnHeaderButton}"
                                Content="{Binding ArchHeader}"
                                Command="{Binding SortByCommand}" CommandParameter="Arch" ToolTip="Sort by architecture" />
                        <Button Grid.Column="4" Style="{StaticResource ColumnHeaderButton}"
                                Content="{Binding IntegrityHeader}"
                                Visibility="{Binding ShowIntegrityColumn, Converter={StaticResource BoolToVis}}"
                                Command="{Binding SortByCommand}" CommandParameter="Integrity" ToolTip="Sort by integrity level" />
                        <Button Grid.Column="5" Style="{StaticResource ColumnHeaderButton}"
                                Content="{Binding WorkingSetHeader}"
                                Command="{Binding SortByCommand}" CommandParameter="WorkingSet" ToolTip="Sort by working set" />
                        <Button Grid.Column="6" Style="{StaticResource ColumnHeaderButton}"
                                Content="{Binding StartedHeader}"
                                Command="{Binding SortByCommand}" CommandParameter="Started" ToolTip="Sort by start time" />
                    </Grid>

                    <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Separator}" />

                    <ListBox x:Name="TargetsList" Grid.Row="1" Style="{StaticResource TableList}"
                             ItemsSource="{Binding View}"
                             SelectedItem="{Binding Selected}" Margin="0,2,0,4" SelectionMode="Single"
                             Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             MouseDoubleClick="Rows_MouseDoubleClick" SelectionChanged="TargetsList_SelectionChanged">
                        <ListBox.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Attach and map modules" Command="{Binding AttachCommand}" />
                                <MenuItem Header="Attach and dump all managed" Command="{Binding AttachAndDumpAllCommand}" />
                                <Separator />
                                <MenuItem Header="Copy PID" Command="{Binding CopyPidCommand}" />
                                <MenuItem Header="Copy process name" Command="{Binding CopyNameCommand}" />
                                <MenuItem Header="Copy image path" Command="{Binding CopyPathCommand}" />
                                <MenuItem Header="Copy command line" Command="{Binding CopyCommandLineCommand}" />
                                <MenuItem Header="Open file location" Command="{Binding OpenFolderCommand}" />
                                <Separator />
                                <MenuItem Header="Suspend process" Command="{Binding SuspendProcessCommand}" />
                                <MenuItem Header="Resume process" Command="{Binding ResumeProcessCommand}" />
                                <Separator />
                                <MenuItem Header="Terminate process…" Command="{Binding TerminateProcessCommand}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="38">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="76" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Id}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                               Foreground="{DynamicResource Dim}" VerticalAlignment="Center" />

                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="20" Height="20" CornerRadius="2" BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource ControlSurface}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsManaged}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource CyanTint}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BadgeBorderCyan}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="7" FontWeight="Bold" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="NAT" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Dim}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsManaged}" Value="True">
                                                                <Setter Property="Text" Value="NET" />
                                                                <Setter Property="Foreground" Value="{DynamicResource CyanText}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" FontSize="12" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Company}" ToolTip="{Binding Company}" FontSize="9.5"
                                                       Foreground="{DynamicResource Dim}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Column="2" Text="{Binding RuntimeLabel}" FontSize="10.5"
                                               Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                                    <TextBlock Grid.Column="3" Text="{Binding ArchitectureLabel}" FontSize="10.5"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding DataContext.ShowIntegrityColumn, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                        <Ellipse Width="4" Height="4" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource Dim}" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsElevated}" Value="True" />
                                                                <Condition Binding="{Binding DataContext.HighlightElevated, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Fill" Value="{DynamicResource Amber}" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding IntegrityLabel}" FontSize="10"
                                                   Foreground="{DynamicResource Muted}" Margin="5,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="5" Text="{Binding SizeLabel}" FontSize="10"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="6" Text="{Binding StartTime, StringFormat={}{0:HH:mm:ss}, TargetNullValue=—}"
                                               FontSize="10" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource Dim}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                   Foreground="{DynamicResource Dim}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyStateTitle}" FontSize="12"
                                   Foreground="{DynamicResource Muted}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyStateHint}" FontSize="10.5"
                                   Foreground="{DynamicResource Dim}" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ScanError}" FontSize="10"
                                   Foreground="{DynamicResource RedText}" Margin="0,8,0,0" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340"
                                   Visibility="{Binding HasScanError, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding ShowScanningState, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                   Foreground="{DynamicResource AccentSoft}" HorizontalAlignment="Center" />
                        <TextBlock Text="Scanning the machine…" FontSize="12" Foreground="{DynamicResource Muted}"
                                   Margin="0,8,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ScanStatusText}" FontSize="10"
                                   Foreground="{DynamicResource Dim}" Margin="0,3,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- details -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <!-- empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                   Foreground="{DynamicResource Dim}" HorizontalAlignment="Center" />
                        <TextBlock Text="Select a process" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Double-click a row to attach and map its managed modules. Right-click for process control."
                                   FontSize="10.5" Foreground="{DynamicResource Dim}" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,5,0,0" MaxWidth="240" />
                    </StackPanel>

                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="14,14,14,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="3" Background="{DynamicResource AccentTint}"
                                        BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1">
                                    <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="250">
                                    <TextBlock Text="{Binding Selected.DisplayName}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Selected.ArchitectureLabel}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="9.5" Foreground="{DynamicResource CyanText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="·" FontSize="9.5" Foreground="{DynamicResource Dim}"
                                                   Margin="6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Selected.PidLabel}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="9.5" Foreground="{DynamicResource Muted}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding Selected.ImagePath}" Style="{StaticResource MonoText}" ToolTip="{Binding Selected.ImagePath}"
                                       FontSize="9.5" Margin="0,10,0,0" TextWrapping="Wrap" MaxHeight="42"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="14,10,8,0">
                            <StackPanel>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,12,0" Text="Runtime" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedRuntimeText}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,12,0" Text="Integrity" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Selected.IntegrityLabel}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,12,0" Text="Elevated" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedElevatedText}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,12,0" Text="Session" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Selected.SessionId}" Style="{StaticResource FieldValueMono}" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,12,0" Text="Modules" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Selected.ModuleCount}" Style="{StaticResource FieldValueMono}" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,12,0" Text="Working set" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedWorkingSetText}" Style="{StaticResource FieldValueMono}" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,12,0" Text="Started" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedStartText}" Style="{StaticResource FieldValueMono}" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,12,0" Text="Company" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Selected.Company}" MaxWidth="190"
                                               Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,12,0" Text="Version" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Selected.FileVersion}" Style="{StaticResource FieldValueMono}" />
                                </Grid>

                                <Border Style="{StaticResource Divider}" Margin="0,8" />

                                <Grid>
                                    <TextBlock Text="COMMAND LINE" Style="{StaticResource LabelCaps}" />
                                    <Button Content="Copy" Style="{StaticResource GhostButton}"
                                            Command="{Binding CopyCommandLineCommand}" FontSize="9"
                                            FontWeight="Normal" Padding="5,1" HorizontalAlignment="Right"
                                            ToolTip="Copy the command line to the clipboard" />
                                </Grid>
                                <Border Style="{StaticResource InsetWell}" Padding="8" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding SelectedCommandLine}" Style="{StaticResource MonoText}"
                                               FontSize="9" TextWrapping="Wrap" MaxHeight="84" />
                                </Border>

                                <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource BorderSoft}"
                                        BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,10,0,0"
                                        Visibility="{Binding Selected.Clr, Converter={StaticResource NullToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="CLR RUNTIME" Style="{StaticResource LabelCaps}" />
                                        <TextBlock Text="{Binding Selected.Clr.DisplayName}" FontSize="11.5"
                                                   FontWeight="Medium" Margin="0,4,0,0" Foreground="{DynamicResource CyanText}" />
                                        <TextBlock Text="{Binding Selected.Clr.ClrModulePath}" Style="{StaticResource MonoText}"
                                                   FontSize="8.5" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource RedTint}" BorderBrush="{DynamicResource BadgeBorderRed}"
                                        BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,10,0,0"
                                        Visibility="{Binding Selected.CanRead, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   Foreground="{DynamicResource Red}" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding SelectedAccessText}" FontSize="10"
                                                   Foreground="{DynamicResource RedText}" TextWrapping="Wrap"
                                                   Margin="7,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="14,10,14,14">
                            <Button Content="Attach &amp; map modules" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding AttachCommand}" Height="32"
                                    ToolTip="{Binding AttachHint}" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Copy path" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CopyPathCommand}" Height="28" FontSize="11"
                                        ToolTip="Copy the executable path to the clipboard" />
                                <Button Grid.Column="2" Content="Show in folder" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding OpenFolderCommand}" Height="28" FontSize="11"
                                        ToolTip="Select the executable in File Explorer" />
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Suspend" Style="{StaticResource SecondaryButton}" Height="28"
                                        FontSize="11" Command="{Binding SuspendProcessCommand}"
                                        ToolTip="Suspend every thread of the selected process" />
                                <Button Grid.Column="2" Content="Resume" Style="{StaticResource SecondaryButton}" Height="28"
                                        FontSize="11" Command="{Binding ResumeProcessCommand}"
                                        ToolTip="Resume a process suspended with Suspend" />
                            </Grid>
                            <Button Content="Terminate process…" Style="{StaticResource DangerButton}" Height="28"
                                    FontSize="11" Margin="0,6,0,0"
                                    Command="{Binding TerminateProcessCommand}"
                                    ToolTip="Terminate the selected process (asks for confirmation)" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

