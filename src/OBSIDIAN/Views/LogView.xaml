<UserControl x:Class="Obsidian.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- row 0: level filters + search -->
            <WrapPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource FilterChip}" Content="All" Margin="0,0,4,0"
                              ToolTip="Every entry"
                              IsChecked="{Binding IsAllLevel, Mode=OneWay}" Command="{Binding SetLevelCommand}"
                              CommandParameter="all" />
                <ToggleButton Style="{StaticResource FilterChip}" Content="Trace" Margin="0,0,4,0"
                              ToolTip="Trace entries only"
                              IsChecked="{Binding IsTraceLevel, Mode=OneWay}" Command="{Binding SetLevelCommand}"
                              CommandParameter="trace" />
                <ToggleButton Style="{StaticResource FilterChip}" Content="Info+" Margin="0,0,4,0"
                              ToolTip="Minimum level: everything except trace entries"
                              IsChecked="{Binding IsInfoLevel, Mode=OneWay}" Command="{Binding SetLevelCommand}"
                              CommandParameter="info" />
                <ToggleButton Style="{StaticResource FilterChip}" Content="Warn+" Margin="0,0,4,0"
                              ToolTip="Minimum level: warnings and errors"
                              IsChecked="{Binding IsWarningLevel, Mode=OneWay}" Command="{Binding SetLevelCommand}"
                              CommandParameter="warning" />
                <ToggleButton Style="{StaticResource FilterChip}" Content="Errors"
                              ToolTip="Errors only"
                              IsChecked="{Binding IsErrorLevel, Mode=OneWay}" Command="{Binding SetLevelCommand}"
                              CommandParameter="error" />

                <Grid Width="230" Margin="10,0,0,0">
                    <TextBox x:Name="LogFilterBox" Style="{StaticResource SearchBox}" Padding="26,5,8,5" FontSize="10.5"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="10"
                               Foreground="{DynamicResource Dim}" Margin="9,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                    <TextBlock Text="Search the log…" FontSize="10" Foreground="{DynamicResource Dim}"
                               Margin="26,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Search, Converter={StaticResource StringEmpty}}" />
                </Grid>
            </WrapPanel>

            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CountLabel}" Style="{StaticResource DimText}"
                       VerticalAlignment="Center" Margin="10,0,0,0" />

            <!-- row 1: follow toggles + export actions -->
            <WrapPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                       Margin="0,6,0,0">
                <CheckBox Style="{StaticResource ObsidianCheckBox}" Content="Follow"
                          ToolTip="Keep the newest entry in view"
                          IsChecked="{Binding AutoScroll}" VerticalAlignment="Center" />
                <CheckBox Style="{StaticResource ObsidianCheckBox}" Content="Timestamps" Margin="12,0,0,0"
                          ToolTip="Show the entry time (persisted setting)"
                          IsChecked="{Binding ShowTimestamps}" VerticalAlignment="Center" />
            </WrapPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="10,6,0,0">
                <Button Content="Copy" Style="{StaticResource GhostButton}" Command="{Binding CopyCommand}"
                        FontSize="10.5" FontWeight="Normal" Padding="8,4"
                        ToolTip="{Binding CopyHint}" />
                <Button Content="Export" Style="{StaticResource GhostButton}" Command="{Binding ExportCommand}"
                        FontSize="10.5" FontWeight="Normal" Padding="8,4"
                        ToolTip="Save the entries currently visible to a .log/.txt file" />
                <Button Content="Clear" Style="{StaticResource GhostButton}" Command="{Binding ClearCommand}"
                        FontSize="10.5" FontWeight="Normal" Padding="8,4"
                        ToolTip="Clear the visible entries and the engine log buffer" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBare}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- log header -->
                <Border Background="{DynamicResource SurfaceHeader}" />
                <Grid Margin="10,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="TIME" Style="{StaticResource TableHeaderText}" Width="78"
                               Visibility="{Binding ShowTimestamps, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="1" Text="LEVEL" Style="{StaticResource TableHeaderText}" />
                    <TextBlock Grid.Column="2" Text="SCOPE" Style="{StaticResource TableHeaderText}" />
                    <TextBlock Grid.Column="3" Text="MESSAGE" Style="{StaticResource TableHeaderText}" />
                </Grid>
                <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Separator}" />

                <ListBox x:Name="LogList" Grid.Row="1" Style="{StaticResource TableList}" ItemsSource="{Binding View}"
                         Margin="2,2,2,4" BorderThickness="0" Background="Transparent"
                         SelectionMode="Extended" SelectionChanged="LogList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="22" ToolTip="{Binding Message}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeLabel}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="9.5" Foreground="{DynamicResource Dim}" VerticalAlignment="Center"
                                           Width="78"
                                           Visibility="{Binding DataContext.ShowTimestamps, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Grid.Column="1" Text="{Binding LevelLabel}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" />
                                <TextBlock Grid.Column="2" Text="{Binding Scope}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="9.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{Binding Message}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="10" Foreground="{DynamicResource TextDim}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsViewEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" FontSize="20"
                               Foreground="{DynamicResource Dim}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyStateTitle}" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyStateHint}"
                               FontSize="10.5" Foreground="{DynamicResource Dim}" Margin="0,3,0,0"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="320" />
                </StackPanel>

                <Button Content="{Binding UnreadLabel}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding JumpToLatestCommand}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,8" Padding="10,4" FontSize="10.5" Height="26"
                        Visibility="{Binding HasUnreadEntries, Converter={StaticResource BoolToVis}}"
                        ToolTip="Jump to the newest entries and re-enable Follow" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

