<Window x:Class="Obsidian.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle}"
        Width="1600" Height="1000" MinWidth="1180" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg0}"
        Icon="Assets/obsidian.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource TextFont}"
        FontSize="12.5"
        Foreground="{DynamicResource Text}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
        <!--
            WPF does not apply an implicit Style that targets Window to a Window
            *subclass*, so the typography settings from Themes/Theme.xaml never
            reached this window. That left every element without an explicit
            Foreground inheriting system black, which is invisible in the dark
            palette. Keep these values in sync with the Window style there.
        -->

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootBorder" Background="{DynamicResource Bg0}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- ============================ title bar ============================ -->
        <Grid Grid.Row="0" Background="{DynamicResource WindowBar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Image Source="Assets/obsidian-mark.png" Width="16" Height="16"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="OBSIDIAN" Margin="8,0,0,0" FontFamily="{StaticResource DisplayFont}"
                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WindowTitleText}"
                           VerticalAlignment="Center" />
                <Border Width="1" Height="12" Background="{DynamicResource SeparatorStrong}" Margin="10,0" />
                <TextBlock Text=".NET DUMPER" FontSize="9" FontWeight="SemiBold"
                           Foreground="{DynamicResource Dim}" VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Height="22" MaxWidth="560" Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
                    CornerRadius="2" Padding="8,0"
                    Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource StatusOnline}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TargetName}" Margin="7,0,0,0" FontSize="11" FontWeight="SemiBold"
                               MaxWidth="240" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding TargetName}" />
                    <TextBlock Text="{Binding TargetPid, StringFormat=pid {0}}" Margin="8,0,0,0"
                               FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                               Foreground="{DynamicResource Dim}" VerticalAlignment="Center" />
                    <Border Width="1" Height="10" Background="{DynamicResource SeparatorStrong}" Margin="8,0" />
                    <TextBlock Text="{Binding TargetArch}" FontSize="9.5" Foreground="{DynamicResource CyanText}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TargetRuntime}" FontSize="9.5" Foreground="{DynamicResource Muted}"
                               Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="210"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetRuntime}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource WindowButton}" Content="&#xE921;" ToolTip="Minimize"
                        AutomationProperties.Name="Minimize" Click="Minimize_Click" />
                <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="&#xE922;"
                        ToolTip="Maximize" AutomationProperties.Name="Maximize" Click="Maximize_Click" />
                <Button Style="{StaticResource WindowButton}" Tag="close" Content="&#xE8BB;" ToolTip="Close"
                        AutomationProperties.Name="Close" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Separator}" />

        <!-- ============================ body ============================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarSurface}"
                    BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,1,0">
                <Grid Margin="8,6,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="WORKSPACE" Style="{StaticResource LabelCaps}" Margin="8,6,0,6" />
                        <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding Navigation}"
                                 SelectedItem="{Binding SelectedNav}" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Subtitle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                                   FontSize="13" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True"
                                                                     Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="8,0,0,0"
                                                   FontSize="12.5" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True"
                                                                     Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Grid.Column="2" Style="{StaticResource BadgeAccent}" Padding="5,0"
                                                MinWidth="18" HorizontalAlignment="Right"
                                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Badge}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="9" Foreground="{DynamicResource AccentText}"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- engine versions -->
                    <StackPanel Grid.Row="1" Margin="8,14,8,0"
                                Visibility="{Binding ShowEngineVersions, Converter={StaticResource BoolToVis}}">
                        <Border Height="1" Background="{DynamicResource Separator}" Margin="0,0,0,10" />
                        <TextBlock Text="ENGINE" Style="{StaticResource LabelCaps}" />
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="dnlib" FontSize="10.5" Foreground="{DynamicResource Dim}" />
                            <TextBlock Text="{Binding DnlibVersion}" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="{DynamicResource Dim}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="ILSpy" FontSize="10.5" Foreground="{DynamicResource Dim}" />
                            <TextBlock Text="{Binding DecompilerVersion}" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="{DynamicResource Dim}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="Runtime" FontSize="10.5" Foreground="{DynamicResource Dim}" />
                            <TextBlock Text="{Binding RuntimeLabel}" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="{DynamicResource Dim}" />
                        </Grid>
                    </StackPanel>

                    <!-- session -->
                    <Border Grid.Row="3" Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
                            CornerRadius="4" Padding="10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="SESSION" Style="{StaticResource LabelCaps}" />
                                <Ellipse Width="5" Height="5" HorizontalAlignment="Right"
                                         Fill="{Binding HasTarget, Converter={StaticResource BoolBrush}}" />
                            </Grid>
                            <TextBlock Text="{Binding TargetName}" FontSize="12" FontWeight="SemiBold"
                                       Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding TargetName}" />
                            <TextBlock Text="{Binding TargetRuntime}" FontSize="10"
                                       Foreground="{DynamicResource Dim}" Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetRuntime}" />
                            <Border Height="1" Background="{DynamicResource Separator}" Margin="0,8" />
                            <Grid>
                                <TextBlock Text="uptime" FontSize="10.5" Foreground="{DynamicResource Muted}" />
                                <TextBlock Text="{Binding SessionUptime}" HorizontalAlignment="Right"
                                           FontFamily="{StaticResource MonoFont}" FontSize="10"
                                           Foreground="{DynamicResource Dim}" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="modules" FontSize="10.5" Foreground="{DynamicResource Muted}" />
                                <TextBlock Text="{Binding Workspace.TotalCount}" HorizontalAlignment="Right"
                                           FontFamily="{StaticResource MonoFont}" FontSize="10"
                                           Foreground="{DynamicResource Dim}" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="dumped" FontSize="10.5" Foreground="{DynamicResource Muted}" />
                                <TextBlock Text="{Binding Workspace.DumpedCount}" HorizontalAlignment="Right"
                                           FontFamily="{StaticResource MonoFont}" FontSize="10"
                                           Foreground="{DynamicResource GreenText}" />
                            </Grid>
                            <Button Content="Detach" Command="{Binding DetachCommand}"
                                    Style="{StaticResource SecondaryButton}" Height="26" Margin="0,10,0,0"
                                    Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- main area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- command bar -->
                <Border Grid.Row="0" Padding="{DynamicResource CommandBarPadding}"
                        Background="{DynamicResource CommandBarSurface}"
                        BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" />
                            <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Caption}"
                                       Margin="0,1,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE72C;"
                                    Command="{Binding RefreshCommand}" ToolTip="Refresh current view (F5)"
                                    AutomationProperties.Name="Refresh view" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8B7;"
                                    Command="{Binding Workspace.OpenOutputCommand}" ToolTip="Open dump folder"
                                    AutomationProperties.Name="Open dump folder" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE7C3;"
                                    Command="{Binding OpenActivityCommand}" ToolTip="Activity log"
                                    AutomationProperties.Name="Activity log" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE713;"
                                    Command="{Binding OpenSettingsCommand}" ToolTip="Settings"
                                    AutomationProperties.Name="Settings" />
                            <Border Style="{StaticResource ToolbarSeparator}" Margin="8,0" />
                            <Button Content="Detach" Command="{Binding DetachCommand}"
                                    Style="{StaticResource GhostButton}" Height="28" Padding="10,4"
                                    Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- pages -->
                <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding CurrentPage}"
                                Margin="{DynamicResource PageMargin}" />
            </Grid>
        </Grid>

        <!-- ============================ status bar ============================ -->
        <Border Grid.Row="2" Background="{DynamicResource StatusBarSurface}"
                BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0"
                Padding="12,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                             Fill="{Binding HasTarget, Converter={StaticResource BoolBrush}}" />
                    <TextBlock Text="{Binding StatusText}" Margin="7,0,0,0" FontSize="10.5"
                               Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                               MaxWidth="700" VerticalAlignment="Center" />
                    <ProgressBar Style="{StaticResource ObsidianProgress}" Width="120" Margin="14,0,0,0"
                                 VerticalAlignment="Center"
                                 Minimum="0" Maximum="{Binding ProgressMax, Mode=OneWay}"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SessionUptime}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                               Foreground="{DynamicResource Dim}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding TargetPid, StringFormat=pid {0}}" FontFamily="{StaticResource MonoFont}"
                               FontSize="10" Foreground="{DynamicResource Dim}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding ClockText}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                               Foreground="{DynamicResource Dim}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding VersionText}" FontSize="10" Foreground="{DynamicResource Dim}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- toasts -->
        <ItemsControl x:Name="ToastItems" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right"
                      VerticalAlignment="Bottom" Margin="0,0,12,36" Width="340" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource ToastSurface}" BorderBrush="{DynamicResource ToastBorder}"
                            BorderThickness="1" CornerRadius="4" Margin="0,0,0,6" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{Binding Accent}" CornerRadius="4,0,0,4" />
                            <Grid Grid.Column="1" Margin="10,8,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                           FontSize="12" Foreground="{Binding Accent}" Margin="0,1,8,0"
                                           VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Message}" FontSize="10.5"
                                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="&#xE8BB;" Style="{StaticResource IconButton}"
                                        Width="20" Height="20" FontSize="8" Tag="{Binding}"
                                        Click="DismissToast_Click" VerticalAlignment="Top"
                                        ToolTip="Dismiss" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
