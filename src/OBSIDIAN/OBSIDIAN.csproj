<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>OBSIDIAN</AssemblyName>
    <RootNamespace>Obsidian</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\obsidian.ico</ApplicationIcon>
    <StartupObject>Obsidian.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Obsidian.Dumper.Core\Obsidian.Dumper.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WPF SDK replaces the default implicit usings; IO is used everywhere. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\obsidian.ico" />
    <Resource Include="Assets\obsidian-mark.png" />
    <!-- Linked from the repo root so the About card's third-party notices link
         works in a built (and published) copy too. -->
    <None Include="..\..\THIRD-PARTY-NOTICES.md"
          Link="THIRD-PARTY-NOTICES.md"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\THIRD-PARTY-NOTICES.md')" />
  </ItemGroup>

  <!--
    The managed agent and its native loader are staged next to the executable so
    a shipped build is self contained. In a raw `dotnet build` the DeepDumper
    also probes the repository layout.
  -->
  <Target Name="BuildAgentPayload" BeforeTargets="BeforeBuild">
    <MSBuild Projects="..\Obsidian.Dumper.Payload\Obsidian.Dumper.Payload.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=;SelfContained=false;Platform=AnyCPU"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishDir;PublishReadyToRun" />
  </Target>

  <Target Name="StageAgentAssets" AfterTargets="Build">
    <ItemGroup>
      <AgentNative Include="..\Obsidian.Dumper.Native\bin\Obsidian.Injector.x64.dll"
                   Condition="Exists('..\Obsidian.Dumper.Native\bin\Obsidian.Injector.x64.dll')" />
      <AgentPayload Include="..\Obsidian.Dumper.Payload\bin\$(Configuration)\net48\Obsidian.Dumper.Payload.dll"
                    Condition="Exists('..\Obsidian.Dumper.Payload\bin\$(Configuration)\net48\Obsidian.Dumper.Payload.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(AgentNative)" DestinationFolder="$(OutDir)native" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(AgentPayload)" DestinationFolder="$(OutDir)payload\net48" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="StageAgentAssetsForPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishNative Include="..\Obsidian.Dumper.Native\bin\Obsidian.Injector.x64.dll"
                     Condition="Exists('..\Obsidian.Dumper.Native\bin\Obsidian.Injector.x64.dll')" />
      <PublishPayload Include="..\Obsidian.Dumper.Payload\bin\$(Configuration)\net48\Obsidian.Dumper.Payload.dll"
                      Condition="Exists('..\Obsidian.Dumper.Payload\bin\$(Configuration)\net48\Obsidian.Dumper.Payload.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishNative)" DestinationFolder="$(PublishDir)native" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PublishPayload)" DestinationFolder="$(PublishDir)payload\net48" SkipUnchangedFiles="true" />
  </Target>

</Project>
