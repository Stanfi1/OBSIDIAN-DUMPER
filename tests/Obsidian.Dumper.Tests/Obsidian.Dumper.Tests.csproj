<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Obsidian.Dumper.Tests</AssemblyName>
    <RootNamespace>Obsidian.Dumper.Tests</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Obsidian.Dumper.Core\Obsidian.Dumper.Core.csproj" />
    <!-- Building the harness also builds the sample target it dumps, so
         `-Target tests -RunTests` is self-contained on a clean tree. -->
    <ProjectReference Include="..\..\samples\TestTarget\TestTarget.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
